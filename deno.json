{
    "unstable": [
        "fmt-component",
        "fmt-sql"
    ],
    "nodeModulesDir": "auto",
    "workspace": [
        "./package/client",
        "./package/contract",
        "./package/database",
        "./package/server",
        "./package/crawler",
        "./package/util"
    ],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "strict": true,
        "noUnusedParameters": true,
        "noErrorTruncation": true
    },
    "fmt": {
        "indentWidth": 4,
        "useTabs": false
    },
    "lint": {
        "rules": {
            "exclude": [
                "no-explicit-any",
                "no-namespace"
            ]
        }
    },
    "imports": {
        "@eslint/js": "npm:@eslint/js@^9.33.0",
        "@std/assert": "jsr:@std/assert@^1.0.14",
        "@typescript-eslint/eslint-plugin": "npm:@typescript-eslint/eslint-plugin@^8.40.0",
        "@typescript-eslint/parser": "npm:@typescript-eslint/parser@^8.40.0",
        "effect": "npm:effect@^3.17.7",
        "gel": "npm:gel@^2.1.1",
        "prettier": "npm:prettier@^3.6.2",
        "swr": "npm:swr@^2.3.6",
        "zod": "npm:zod@^4.0.17"
    }
}
