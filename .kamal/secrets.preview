# preview unit secrets (merged with .kamal/secrets-common).
SECRETS=$(sops --decrypt config/secrets/preview.enc.env)
DATABASE_URL=$(kamal secrets extract DATABASE_URL $SECRETS)
AUTH_INTERNAL_TOKEN_GATEWAY_SECRET=$(kamal secrets extract AUTH_INTERNAL_TOKEN_GATEWAY_SECRET $SECRETS)
SMTP_HOST=$(kamal secrets extract SMTP_HOST $SECRETS)
SMTP_USER=$(kamal secrets extract SMTP_USER $SECRETS)
SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD $SECRETS)
TURNSTILE_SECRET=$(kamal secrets extract TURNSTILE_SECRET $SECRETS)
NOTIFY_INTERNAL_SECRET=$(kamal secrets extract NOTIFY_INTERNAL_SECRET $SECRETS)
REACTION_INTERNAL_SECRET=$(kamal secrets extract REACTION_INTERNAL_SECRET $SECRETS)
JOB_RUNNER_INTERNAL_SECRET=$(kamal secrets extract JOB_RUNNER_INTERNAL_SECRET $SECRETS)
