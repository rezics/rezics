# history unit secrets (merged with .kamal/secrets-common).
SECRETS=$(sops --decrypt config/secrets/history.enc.env)
HISTORY_DATABASE_URL=$(kamal secrets extract HISTORY_DATABASE_URL $SECRETS)
SERVER_DATABASE_URL=$(kamal secrets extract SERVER_DATABASE_URL $SECRETS)
HISTORY_INTERNAL_SECRET=$(kamal secrets extract HISTORY_INTERNAL_SECRET $SECRETS)
