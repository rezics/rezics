# ranking unit secrets (merged with .kamal/secrets-common).
SECRETS=$(sops --decrypt config/secrets/ranking.enc.env)
RANKING_DATABASE_URL=$(kamal secrets extract RANKING_DATABASE_URL $SECRETS)
SERVER_DATABASE_URL=$(kamal secrets extract SERVER_DATABASE_URL $SECRETS)
REACTION_INTERNAL_SECRET=$(kamal secrets extract REACTION_INTERNAL_SECRET $SECRETS)
