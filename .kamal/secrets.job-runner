# job-runner unit secrets (merged with .kamal/secrets-common).
SECRETS=$(sops --decrypt config/secrets/job-runner.enc.env)
JOB_DATABASE_URL=$(kamal secrets extract JOB_DATABASE_URL $SECRETS)
SERVER_DATABASE_URL=$(kamal secrets extract SERVER_DATABASE_URL $SECRETS)
HISTORY_DATABASE_URL=$(kamal secrets extract HISTORY_DATABASE_URL $SECRETS)
JOB_RUNNER_INTERNAL_SECRET=$(kamal secrets extract JOB_RUNNER_INTERNAL_SECRET $SECRETS)
RANKING_INTERNAL_SECRET=$(kamal secrets extract RANKING_INTERNAL_SECRET $SECRETS)
