# Shared secrets, available to every destination and to accessory boots.
# Decrypted from config/secrets/common.enc.env via SOPS + age at deploy time
# (set SOPS_AGE_KEY_FILE / SOPS_AGE_KEY on the CI runner or operator host).
SECRETS=$(sops --decrypt config/secrets/common.enc.env)

# GHCR pull/push credential.
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)

# Infra accessory credentials (infra-db, infra-search, infra-cdc).
POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD $SECRETS)
MEILI_MASTER_KEY=$(kamal secrets extract MEILI_MASTER_KEY $SECRETS)
PG_PASSWORD=$(kamal secrets extract PG_PASSWORD $SECRETS)
SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
VAULT_KEY=$(kamal secrets extract VAULT_KEY $SECRETS)

# Cross-unit shared application secret (infra-cdc -> job-runner).
SEQUIN_WEBHOOK_SECRET=$(kamal secrets extract SEQUIN_WEBHOOK_SECRET $SECRETS)

# Sequin source-database credentials (= the infra-db postgres password in v1).
SOURCE_DB_PASSWORD=$(kamal secrets extract SOURCE_DB_PASSWORD $SECRETS)
REACTION_DB_PASSWORD=$(kamal secrets extract REACTION_DB_PASSWORD $SECRETS)
