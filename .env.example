# Compose and Aspire consume this same local-development contract. Compose owns
# PostgreSQL/RustFS; Aspire owns the API, worker, and web processes.
HOST=0.0.0.0
PORT=3001
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
REZICS_API_ORIGIN=http://localhost:3001
# CSS-only Font Awesome v7.2.0 hosted Kit. Configure the Kit as Web Fonts,
# By Style, with Classic Solid and Brands enabled and the version pinned.
# Paste the HTTPS href from the Kit's CSS-only embed code; leave blank to disable.
FONT_AWESOME_KIT_CSS_URL=
FONT_AWESOME_KIT_LICENSE=free
# PostgreSQL 18+; migrations use the owner connection while the API runs with
# the deliberately narrower application role.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/rezics?sslmode=disable
DATABASE_URL=postgres://rezics_app:rezics_app@localhost:5432/rezics?sslmode=disable
DATABASE_BACKUP_URL=postgres://rezics_backup:rezics_backup@localhost:5432/rezics?sslmode=disable
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECTION_TIMEOUT_MS=2000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_MAX_LIFETIME_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=10000
BETTER_AUTH_SECRET=replace-with-a-generated-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Cloudflare's documented always-pass test pair is for local development only.
# Production must use a Managed Widget restricted to its public hostnames.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
# Use log locally. Production uses Cloudflare Email Sending's REST API.
EMAIL_MODE=log
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=REZICS
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_DISPATCH_POLL_INTERVAL_MS=1000
EMAIL_DISPATCH_BATCH_SIZE=20
EMAIL_DISPATCH_MAX_ATTEMPTS=5
# S3-compatible object storage. These defaults target the Compose-managed
# RustFS resource. In production, use
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com and an R2 API token's keys.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET=rezics
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_IN=900
# Reap abandoned uploads after the signed URL expires plus a five-minute grace.
IMAGE_ASSET_CLEANUP_INTERVAL_MS=300000
IMAGE_ASSET_CLEANUP_GRACE_MS=300000
IMAGE_ASSET_CLEANUP_BATCH_SIZE=100
# The automated Custom Theme reviewer fails closed when this Browser Run
# renderer pair is absent. Use the web Worker's internal HTTPS endpoint and a
# dedicated high-entropy secret; never reuse a user or API credential.
CUSTOM_THEME_REFERENCE_RENDERER_URL=
CUSTOM_THEME_REFERENCE_RENDER_TOKEN=
SEARCH_STATEMENT_TIMEOUT_MS=1500
# Facets are authoritative but deliberately bounded; truncated counts are marked lower-bound.
SEARCH_FACET_SCAN_LIMIT=1000
# Atomic sparse-best snapshot refresh cadence; the default is once per hour.
RECOMMENDATION_REFRESH_INTERVAL_MS=3600000
# Expired API quota leases and bounded usage-state retention cleanup cadence.
API_QUOTA_CLEANUP_INTERVAL_MS=3600000
# Scheduler-only recommendation worker health listener. Aspire injects an
# isolated port and overrides the host for its local proxy.
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002
# Server telemetry is emitted over OTLP/HTTP protobuf when Aspire or production
# provides an endpoint. Without an endpoint, traces and metrics stay local/no-op.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
REZICS_OBSERVABILITY_HTTP_ENABLED=true
REZICS_OBSERVABILITY_DATABASE_ENABLED=true
REZICS_OBSERVABILITY_STORAGE_ENABLED=true
REZICS_OBSERVABILITY_WORKER_ENABLED=true
REZICS_OBSERVABILITY_SHUTDOWN_TIMEOUT_MS=5000
