# Compose and Aspire consume this same local-development contract. Compose owns
# PostgreSQL/RustFS; Aspire owns the API, worker, and web processes.
HOST=0.0.0.0
PORT=3001
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
# CSS-only Font Awesome v7.2.0 hosted Kit. Configure the Kit as Web Fonts,
# By Style, with Classic Solid and Brands enabled and the version pinned.
FONT_AWESOME_KIT_CSS_URL=
FONT_AWESOME_KIT_LICENSE=free
# PostgreSQL 18+; migrations use the owner connection while the API runs with
# the deliberately narrower application role.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/rezics?sslmode=disable
DATABASE_URL=postgres://rezics_app:rezics_app@localhost:5432/rezics?sslmode=disable
BETTER_AUTH_SECRET=replace-with-a-generated-32-byte-secret
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Use log locally. Production uses Cloudflare Email Sending's REST API.
EMAIL_MODE=log
EMAIL_FROM=no-reply@example.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
# S3-compatible object storage. These defaults target the Compose-managed
# RustFS resource. In production, use
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com and an R2 API token's keys.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET=rezics
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_IN=900
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=rezics-development-meilisearch-key
MEILISEARCH_CURRENT_INDEX_UID=rezics_units_v3_20260722
MEILISEARCH_CURRENT_SINK_NAME=rezics-units-v3-20260722
MEILISEARCH_HISTORY_INDEX_UID=rezics_revisions_v1_20260720
# Runtime/API, CDC, and lifecycle credentials are separate in production. Local
# development may point all of them at the Compose master key.
MEILISEARCH_QUERY_KEY=rezics-development-meilisearch-key
MEILISEARCH_RECONCILER_KEY=rezics-development-meilisearch-key
SEQUIN_URL=http://localhost:7376
SEQUIN_API_TOKEN=rezics-development-sequin-api-token
SEQUIN_ADMIN_PASSWORD=rezics-development-sequin-admin
SEQUIN_STATE_POSTGRES_PASSWORD=sequin
SEARCH_CANDIDATE_BATCH_SIZE=100
SEARCH_CANDIDATE_SCAN_LIMIT=10000
# Atomic recommendation snapshot refresh cadence (minimum 60 seconds).
RECOMMENDATION_REFRESH_INTERVAL_MS=300000
# Scheduler-only recommendation worker health listener. Aspire injects an
# isolated port and overrides the host for its local proxy.
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002
# Server telemetry is emitted over OTLP/HTTP protobuf when Aspire or production
# provides an endpoint. Without an endpoint, traces and metrics stay local/no-op.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
REZICS_OBSERVABILITY_HTTP_ENABLED=true
REZICS_OBSERVABILITY_DATABASE_ENABLED=true
REZICS_OBSERVABILITY_STORAGE_ENABLED=true
REZICS_OBSERVABILITY_WORKER_ENABLED=true
REZICS_OBSERVABILITY_SHUTDOWN_TIMEOUT_MS=5000
