# Job runner producer settings used by @rezics/server.
JOB_RUNNER_BASE_URL="http://localhost:3005"
JOB_RUNNER_INTERNAL_SECRET="dev-job-runner-secret"

# Job runner service settings used by @rezics/job-runner.
JOB_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_jobs"
SERVER_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_booklib?schema=public"
HISTORY_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_history?schema=public"
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="dev-meili-master-key"
SEQUIN_WEBHOOK_SECRET="dev-sequin-secret"
JOB_RUNNER_ROLE="all"
PORT="3005"

# History cutover. The poller is disabled by default; opt in only as a temporary fallback.
HISTORY_QUEUE_INGESTION_ENABLED="true"
# HISTORY_OUTBOX_POLLER_FALLBACK="1"
