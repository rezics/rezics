# Auth service image. Own schema; compiles the cluster entrypoint
# (src/cluster.ts → binary named `server`). Drizzle uses the pure-JS `pg`
# driver, so the compiled runtime needs no query engine.
#
#   docker build -f Dockerfile.base -t rezics-base:dev .
#   docker build -f Dockerfile.auth -t rezics-auth:dev .

# --- build stage -----------------------------------------------------------
ARG BASE_IMAGE=rezics-base:dev
FROM ${BASE_IMAGE} AS build
WORKDIR /repo/packages/auth

ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
# Compile the linux-x64 binary inline (mirrors `task auth:build:linux`).
RUN bun build src/cluster.ts --compile --minify-whitespace --minify-syntax \
  --target bun-linux-x64 --outfile server

# --- runtime stage ---------------------------------------------------------
FROM debian:bookworm-slim AS runtime
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --system --uid 10001 --no-create-home rezics
WORKDIR /app

# build:linux emits a binary named `server`; rename to `auth` for clarity.
COPY --from=build /repo/packages/auth/server /app/auth

USER rezics
ENV PORT=3001
ENV WORKERS=""
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1

ENTRYPOINT ["/app/auth"]
