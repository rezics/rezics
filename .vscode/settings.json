    "component": "components",
    "state": "store"
  },
  "symbols.folders.associations": {
    "component": "folder-green-code",
    "section": "folder-purple-code",
    "page": "folder-blue-code",
    "state": "folder-redux-reducer",
    "model": "folder-models",
    "style": "folder-purple-code",
    "locale": "folder-i18n"
  }
