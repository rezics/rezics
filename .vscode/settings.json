{
  "cSpell.words": [
    "backpressure",
    "booklist",
    "deno",
    "denoland",
    "edgeql",
    "Evaluable",
    "icsid",
    "libphonenumber",
    "pgcrypto",
    "pnpx",
    "qidian",
    "readlist",
    "rebrowser",
    "refetches",
    "Tagable",
    "TCRUD",
    "urql",
    "uuid",
    "uuidv",
    "wouter"
  ],
  "i18n-ally.localesPaths": ["package/client/src/locale"],
  "i18n-ally.enabledParsers": ["js", "ts", "json"],
  "i18n-ally.enabledFrameworks": ["react-i18next"],
  "i18n-ally.keystyle": "nested",
  "gel.project-dir": "package/database",
  "files.exclude": {
    "package/database/dbschema/migrations": true
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
