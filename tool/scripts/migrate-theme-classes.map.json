  "ambiguous": {
    "bg-rezics-color-bg-hover": {
      "default": "bg-surface-subtle",
      "needs_review": true,
      "comment": "Legacy --rezics-color-bg-hover encodes the hover state in the name. If the call-site already has a `hover:` / `group-hover:` / state modifier, the substitution is correct (the modifier carries the state semantics). If the call-site is BARE (no modifier), the substitution loses the hover semantics — wrap in hover: or rewrite to a state-layer overlay (see uno-config shortcuts: state-hover)."
    },
    "bg-rezics-color-bg-selected": {
      "default": "bg-primary-container",
      "needs_review": true,
      "comment": "Legacy --rezics-color-bg-selected aliases to --rezics-sys-color-primary-container. Most call-sites mean 'currently selected nav item' which matches. Audit each site: if the intent was 'fadeable selection state' (no permanent fill), rewrite to a state-layer overlay or hover:bg-surface-subtle."
    }
