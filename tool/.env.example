# Tool package environment.
# Copy this file to tool/.env before running repo-level tool scripts.

# Docker Compose v2 is the only supported runtime for repo-managed services.
# Podman, podman-compose, and docker-compose v1 are not supported here.

# Optional published host ports for the managed stack.
SOURCE_DB_PORT_PUBLISHED=5432
MEILI_PORT_PUBLISHED=7700
SEQUIN_PORT_PUBLISHED=7376

# Sequin health endpoint used by `bun run service health`.
SEQUIN_HEALTH_URL=http://127.0.0.1:7376/health

# Sequin state Postgres password. Local example only.
PG_PASSWORD=DO-NOT-USE-IN-PRODUCTION-sequin-state-postgres

# Generate real local values before starting Sequin:
#   openssl rand -base64 48  # SECRET_KEY_BASE
#   openssl rand -base64 32  # VAULT_KEY
SECRET_KEY_BASE=DO-NOT-USE-IN-PRODUCTION-secret-key-base
VAULT_KEY=DO-NOT-USE-IN-PRODUCTION-vault-key

# Source database consumed by Sequin CDC inside the managed Docker network.
ENV=development
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=rezics_server
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=postgres

# Reaction database consumed by Sequin CDC inside the managed Docker network.
REACTION_DB_HOST=source-postgres
REACTION_DB_PORT=5432
REACTION_DB_NAME=rezics_reaction
REACTION_DB_USER=postgres
REACTION_DB_PASSWORD=postgres

# Meilisearch credentials for the managed local service.
MEILI_MASTER_KEY=masterKey

# Job-runner webhook target from inside the Sequin container.
SEQUIN_JOB_RUNNER_BASE_URL=http://host.docker.internal:3005

# Must match package/job-runner/.env SEQUIN_WEBHOOK_SECRET.
SEQUIN_WEBHOOK_SECRET=change-me-sequin-webhook-secret
