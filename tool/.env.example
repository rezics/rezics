# Tool package environment.
# Copy this file to tool/.env before running repo-level tool scripts.

# Optional. When unset, the Sequin wrapper auto-detects podman compose,
# podman-compose, then docker compose.
# Supported values: podman, podman-compose, docker.
# CONTAINER_RUNTIME=docker

# Sequin health endpoint used by `bun run service:sequin:health`.
SEQUIN_HEALTH_URL=http://127.0.0.1:7376/health

# Sequin state Postgres password. Local example only.
PG_PASSWORD=DO-NOT-USE-IN-PRODUCTION-sequin-state-postgres

# Generate real values before starting Sequin:
#   openssl rand -base64 48  # SECRET_KEY_BASE
#   openssl rand -base64 32  # VAULT_KEY
SECRET_KEY_BASE=DO-NOT-USE-IN-PRODUCTION-secret-key-base
VAULT_KEY=DO-NOT-USE-IN-PRODUCTION-vault-key

# Source database consumed by Sequin CDC.
ENV=development
SOURCE_DB_HOST=host.docker.internal
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=rezics_booklib
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=postgres

# Job-runner webhook target inside the container runtime.
SEQUIN_JOB_RUNNER_BASE_URL=http://host.docker.internal:3005

# Must match package/job-runner/.env SEQUIN_WEBHOOK_SECRET.
SEQUIN_WEBHOOK_SECRET=change-me-sequin-webhook-secret
