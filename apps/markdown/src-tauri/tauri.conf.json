{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "REZICS Markdown",
	"version": "1.0.0",
	"identifier": "com.rezics.markdown",
	"build": {
		"beforeDevCommand": "yarn workspace @rezics/markdown-editor-web dev",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "yarn workspace @rezics/markdown-editor-web build",
		"frontendDist": "../packages/web/dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "REZICS Markdown",
				"width": 1280,
				"height": 840,
				"minWidth": 760,
				"minHeight": 560,
				"center": true
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Productivity",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
