{
	"name": "@rezics/markdown-editor",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-only",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "tauri dev",
		"dev:web": "yarn workspace @rezics/markdown-editor-web dev",
		"build": "node scripts/build-desktop.mjs",
		"build:web": "yarn workspace @rezics/markdown-editor-web build",
		"typecheck": "yarn workspace @rezics/markdown-editor-app typecheck && yarn workspace @rezics/markdown-editor-web typecheck",
		"test": "yarn workspace @rezics/markdown-editor-app test && yarn workspace @rezics/markdown-editor-web test",
		"rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
		"rust:test": "cargo test --manifest-path src-tauri/Cargo.toml"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.11.4"
	}
}
