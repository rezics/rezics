---
import type { AboutLocale } from "../../i18n/locales";
import { getProductPath } from "../../i18n/productPaths";
import { getLocalizedProductCopy } from "../../content/productCopy";
import type { ProductDefinition } from "../../content/productTypes";
import { getSiteCopy } from "../../content/siteCopy";
import ProductDemo from "./ProductDemo.astro";

type Props = {
  locale: AboutLocale;
  products: readonly ProductDefinition[];
  instanceId: string;
  compact?: boolean;
};

const { locale, products, instanceId, compact = true } = Astro.props;
const copy = getSiteCopy(locale);
---

<div class="directory-layout" data-product-directory>
  <div
    class="directory-list"
    role="tablist"
    aria-label={copy.directory.previewInstruction}
  >
    {products.map((product, index) => {
      const productCopy = getLocalizedProductCopy(locale, product.id as never);
      const panelId = `${instanceId}-panel-${product.slug}`;
      return (
        <button
          class="directory-button"
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? "0" : "-1"}
          aria-controls={panelId}
          data-directory-button
        >
          <span>
            <strong>{product.name}</strong>
            <span style="display:block;margin-top:.28rem;font-size:.76rem;line-height:1.5">
              {productCopy.summary}
            </span>
          </span>
          <span>{copy.status[product.implementationStatus]}</span>
        </button>
      );
    })}
  </div>

  <div class="directory-preview">
    {products.map((product, index) => {
      const panelId = `${instanceId}-panel-${product.slug}`;
      return (
        <section id={panelId} role="tabpanel" hidden={index !== 0}>
          <ProductDemo
            kind={product.demoKind}
            name={product.name}
            locale={locale}
            instanceId={`${instanceId}-demo-${product.slug}`}
            compact={compact}
          />
          <a
            class="text-link"
            style="margin-top: 1rem"
            href={getProductPath(locale, product.slug)}
          >
            {copy.common.viewProduct} · {product.name} →
          </a>
        </section>
      );
    })}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-product-directory]").forEach((directory) => {
    directory.querySelectorAll<HTMLButtonElement>("[data-directory-button]").forEach((button) => {
      const activate = () => {
        if (button.getAttribute("aria-selected") === "true") return;
        button.click();
      };
      button.addEventListener("focus", activate);
      button.addEventListener("pointerenter", (event) => {
        if ((event as PointerEvent).pointerType !== "touch") activate();
      });
    });
  });
</script>
