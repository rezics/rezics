---
import {
  ABOUT_LOCALES,
  type AboutLocale,
} from "../../i18n/locales";
import { getProductsPath } from "../../i18n/productPaths";

export function getStaticPaths() {
  return ABOUT_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as AboutLocale;
const redirectTarget = getProductsPath(locale);
return Astro.redirect(redirectTarget, 301);
---

<span hidden data-redirect-target={redirectTarget}></span>
