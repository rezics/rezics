---
import { PRODUCT_DEFINITIONS } from "../../../content/productRegistry";
import {
  ABOUT_LOCALES,
  type AboutLocale,
} from "../../../i18n/locales";
import { getProductPath } from "../../../i18n/productPaths";

export function getStaticPaths() {
  const legacyProductSlugs = [
    ...PRODUCT_DEFINITIONS.map((product) => product.slug),
    "entity-source",
  ];

  return ABOUT_LOCALES.flatMap((locale) =>
    legacyProductSlugs.map((slug) => ({
      params: { locale, slug },
    })),
  );
}

const locale = Astro.params.locale as AboutLocale;
const legacySlug = Astro.params.slug ?? "";
const currentSlug =
  legacySlug === "entity-source" ? "entity-attribution" : legacySlug;
const redirectTarget = getProductPath(locale, currentSlug);
return Astro.redirect(redirectTarget, 301);
---

<span hidden data-redirect-target={redirectTarget}></span>
