---
import { ABOUT_LOCALES, requireAboutLocale } from "../../../i18n/locales";
import { getProductsPath } from "../../../i18n/productPaths";

export function getStaticPaths() {
	return ABOUT_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = requireAboutLocale(Astro.params.locale);
const targetPath = getProductsPath(locale);
if (targetPath) return Astro.redirect(targetPath, 301);
throw new Error(`Missing Products redirect target for ${locale}.`);
---
