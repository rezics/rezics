---
import { buttonVariants } from "@rezics/ui";

import { ProductStageBadge } from "../../../components/ProductStageBadge";
import { HOW_MECHANISM_DEFINITIONS, HOW_SCOPE_IDS } from "../../../content/howMechanisms";
import { getProductDocuments } from "../../../content/productDocuments";
import { getSiteCopy } from "../../../content/locales";
import { ABOUT_LOCALES, requireAboutLocale } from "../../../i18n/locales";
import { getProductPath, getProductsPath, getUsesPath } from "../../../i18n/productPaths";
import SiteLayout from "../../../layouts/SiteLayout.astro";

export function getStaticPaths() {
	return ABOUT_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = requireAboutLocale(Astro.params.locale);
const copy = getSiteCopy(locale);
const howV1 = copy.how.v1;
const stageCopy = copy.products.stage;
if (howV1 && !stageCopy) {
	throw new Error(`The mechanism page requires localized product stage labels: ${locale}`);
}
if (howV1 && howV1.scope.layers.length !== HOW_SCOPE_IDS.length) {
	throw new Error(`The mechanism page requires ${HOW_SCOPE_IDS.length} scope layers: ${locale}`);
}
if (howV1 && howV1.mechanisms.items.length !== HOW_MECHANISM_DEFINITIONS.length) {
	throw new Error(
		`The mechanism page requires ${HOW_MECHANISM_DEFINITIONS.length} mechanisms: ${locale}`,
	);
}

const productDocuments = howV1 ? await getProductDocuments(locale) : [];
const scopeEntries =
	howV1?.scope.layers.map((scope, index) => {
		const id = HOW_SCOPE_IDS[index];
		if (!id) throw new Error(`Missing scope identity at index ${index}: ${locale}`);
		return { id, scope };
	}) ?? [];
const mechanismEntries =
	howV1?.mechanisms.items.map((mechanism, index) => {
		const definition = HOW_MECHANISM_DEFINITIONS[index];
		if (!definition) throw new Error(`Missing mechanism identity at index ${index}: ${locale}`);
		const product = productDocuments.find(
			({ definition: productDefinition }) => productDefinition.id === definition.productId,
		);
		if (!product?.document.data.statusNote) {
			throw new Error(
				`The mechanism page requires a localized status note for ${locale}/${definition.productId}`,
			);
		}

		return { definition, mechanism, product };
	}) ?? [];
---

<SiteLayout locale={locale} active="how" pageKind="how-it-works" meta={copy.meta.how}>
  <section class="page-hero">
    <div class="shell page-hero__inner">
      <p class="eyebrow">{copy.how.eyebrow}</p>
      <h1>{copy.how.title}</h1>
      <p class="hero-lead">{copy.how.lead}</p>
    </div>
  </section>

  {
    howV1 && stageCopy ? (
      <>
        <section class="page-section how-scope-section" aria-labelledby="how-scope-title">
          <div class="shell how-scope-layout">
            <div class="section-heading">
              <p class="section-index">01</p>
              <h2 id="how-scope-title">{howV1.scope.title}</h2>
              <p>{howV1.scope.body}</p>
            </div>
            <div class="how-scope-map">
              {scopeEntries.map(({ id, scope }, index) => (
                <article class="how-scope-lane" data-scope={id}>
                  <span class="how-scope-lane__index" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div class="how-scope-lane__heading">
                    <h3>{scope.title}</h3>
                    <p>{scope.body}</p>
                  </div>
                  <ul>
                    {scope.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="page-section how-mechanisms-section" aria-labelledby="how-mechanisms-title">
          <div class="shell">
            <div class="section-heading">
              <p class="section-index">02</p>
              <h2 id="how-mechanisms-title">{howV1.mechanisms.title}</h2>
              <p>{howV1.mechanisms.body}</p>
            </div>
            <div class="mechanism-ledger">
              {mechanismEntries.map(({ definition, mechanism, product }, index) => (
                <article class="mechanism-row" id={`mechanism-${definition.id}`}>
                  <span class="mechanism-row__index" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <header class="mechanism-row__heading">
                    <h3>{mechanism.title}</h3>
                    <p>{mechanism.body}</p>
                  </header>
                  <div class="mechanism-row__detail">
                    <ul class="mechanism-points">
                      {mechanism.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                    <section class="mechanism-example">
                      <p class="mechanism-label">{howV1.mechanisms.exampleLabel}</p>
                      <h4>{mechanism.example.title}</h4>
                      <p>{mechanism.example.body}</p>
                    </section>
                    <div class="mechanism-rule">
                      <strong>{howV1.mechanisms.ruleLabel}</strong>
                      <p>{mechanism.rule}</p>
                    </div>
                    <footer class="mechanism-status">
                      <ProductStageBadge
                        label={stageCopy.labels[product.definition.stage]}
                        stage={product.definition.stage}
                      />
                      <p>{product.document.data.statusNote}</p>
                      <a href={getProductPath(locale, product.definition.slug)}>
                        {howV1.mechanisms.capabilityLabel}｜{product.document.data.title}
                      </a>
                    </footer>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="page-section how-loop-section" aria-labelledby="how-loop-title">
          <div class="shell">
            <div class="section-heading">
              <p class="section-index">03</p>
              <h2 id="how-loop-title">{howV1.loop.title}</h2>
              <p>{howV1.loop.body}</p>
            </div>
            <ol class="network-loop">
              {howV1.loop.steps.map((step) => (
                <li>
                  <span aria-hidden="true" />
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </li>
              ))}
            </ol>
            <p class="how-loop-closing">{howV1.loop.closing}</p>
            <div class="hero-actions how-loop-actions">
              <a
                class={buttonVariants({ variant: "brand", size: "xl" })}
                href={getProductsPath(locale)}
              >
                {howV1.loop.capabilitiesAction}
              </a>
              <a
                class={buttonVariants({ variant: "outline", size: "xl" })}
                href={getUsesPath(locale)}
              >
                {howV1.loop.usesAction}
              </a>
            </div>
          </div>
        </section>
      </>
    ) : (
      <>
        <section class="page-section">
          <div class="shell stage-grid">
            {copy.how.stages.map((stage) => (
              <article class="stage-card">
                <h2>{stage.title}</h2>
                <p>{stage.body}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="page-section">
          <div class="shell split-statement">
            <h2>{copy.how.integrity.title}</h2>
            <div><p>{copy.how.integrity.body}</p></div>
          </div>
        </section>
      </>
    )
  }
</SiteLayout>
