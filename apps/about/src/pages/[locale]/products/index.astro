---
import { ArrowRight } from "lucide-react";

import { ProductStageBadge } from "../../../components/ProductStageBadge";
import { getProductDocuments } from "../../../content/productDocuments";
import { getSiteCopy } from "../../../content/locales";
import { PRODUCT_STAGE_IDS } from "../../../content/productTypes";
import { ABOUT_LOCALES, requireAboutLocale } from "../../../i18n/locales";
import { getProductPath } from "../../../i18n/productPaths";
import SiteLayout from "../../../layouts/SiteLayout.astro";

export function getStaticPaths() {
	return ABOUT_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = requireAboutLocale(Astro.params.locale);
const copy = getSiteCopy(locale);
const products = await getProductDocuments(locale);
const items = products.map(({ definition, document }) => ({
	id: definition.id,
	stage: definition.stage,
	title: document.data.title,
	summary: document.data.summary,
	href: getProductPath(locale, definition.slug),
}));
---

<SiteLayout locale={locale} active="products" pageKind="products" meta={copy.meta.products}>
  <section class="page-hero">
    <div class="shell page-hero__inner">
      <p class="eyebrow">{copy.products.eyebrow}</p>
      <h1>{copy.products.title}</h1>
      <p class="hero-lead">{copy.products.lead}</p>
    </div>
  </section>

  <section class="page-section products-directory-section">
    <div class="shell directory">
      <div aria-label={copy.products.stage.legend} class="stage-legend">
        <span>{copy.products.stage.legend}</span>
        {PRODUCT_STAGE_IDS.map((stage) => (
          <ProductStageBadge label={copy.products.stage.labels[stage]} stage={stage} />
        ))}
      </div>
      <ol class="product-index product-index--editorial">
        {items.map((item, index) => (
          <li>
            <a class="product-index-row" href={item.href}>
              <span class="product-index-row__number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
              <ProductStageBadge
                label={copy.products.stage.labels[item.stage]}
                stage={item.stage}
              />
              <ArrowRight aria-hidden="true" />
              <span class="sr-only">{copy.products.openProduct}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</SiteLayout>
