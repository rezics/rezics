---
import ProductsDirectoryPage from "../../../components/products/ProductsDirectoryPage.astro";
import {
  ABOUT_LOCALES,
  type AboutLocale,
} from "../../../i18n/locales";

export function getStaticPaths() {
  return ABOUT_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as AboutLocale;
---

<ProductsDirectoryPage locale={locale} />
