---
import ProductPage from "../../../components/products/ProductPage.astro";
import { PRODUCT_DEFINITIONS } from "../../../content/productRegistry";
import {
  ABOUT_LOCALES,
  type AboutLocale,
} from "../../../i18n/locales";

export function getStaticPaths() {
  return ABOUT_LOCALES.flatMap((locale) =>
    PRODUCT_DEFINITIONS.map((product) => ({
      params: { locale, slug: product.slug },
      props: { product },
    })),
  );
}

const locale = Astro.params.locale as AboutLocale;
const { product } = Astro.props;
---

<ProductPage locale={locale} product={product} />
