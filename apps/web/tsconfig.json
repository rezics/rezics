{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["./*"]
		},
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"noEmit": true,
		"jsx": "react-jsx",
		"plugins": [{ "name": "next" }]
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".storybook/**/*.ts",
		".storybook/**/*.tsx",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules", ".vinext", "dist", "worker", "worker-configuration.d.ts"]
}
