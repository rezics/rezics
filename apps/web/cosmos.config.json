{
	"$schema": "./node_modules/react-cosmos/config.schema.json",
	"rootDir": "../..",
	"plugins": ["react-cosmos-plugin-vite"],
	"exportPath": ".temp/cosmos-export",
	"globalImports": ["./apps/web/styles/global.css"],
	"staticPath": "apps/web/public",
	"ui": {
		"responsivePreview": {
			"devices": [
				{ "label": "Mobile · 390", "width": 390, "height": 844 },
				{ "label": "Tablet · 768", "width": 768, "height": 1024 },
				{ "label": "Desktop · 1280", "width": 1280, "height": 900 }
			]
		}
	},
	"vite": {
		"configPath": "./apps/web/cosmos.vite.config.ts"
	}
}
