{
	"name": "@rezics/frontend",
	"version": "1.11.0",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-only",
	"scripts": {
		"build": "vinext build",
		"storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
		"storybook:build": "storybook build --output-dir ../../.temp/storybook/static",
		"storybook:test": "vitest run --project storybook",
		"deploy:cloudflare": "vinext-cloudflare deploy --env production",
		"dev": "vinext dev",
		"generate:offline": "node scripts/generate-offline-page.ts",
		"generate:offline:check": "node scripts/generate-offline-page.ts --check",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
		"typegen:cloudflare": "wrangler types --env production",
		"typegen:cloudflare:check": "wrangler types --env production --check",
		"storybook:aspire": "storybook dev --port \"$STORYBOOK_PORT\" --host 127.0.0.1 --no-open --exact-port"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
