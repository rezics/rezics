		"@rezics/block": "workspace:*",
		"@rezics/content-language": "workspace:*",
		"@rezics/filter": "workspace:*",
		"@rezics/i18n": "workspace:*",
		"@rezics/icons": "^0.1.2",
		"@rezics/license": "workspace:*",
		"@rezics/openapi-tanstack-query": "workspace:*",
		"@rezics/portable-text": "workspace:*",
		"@rezics/slug": "workspace:*",
		"@rezics/ui": "workspace:*",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-virtual": "^3.14.11",
		"better-auth": "1.7.3",
		"emojibase": "17.0.0",
		"emojibase-data": "17.0.0",
		"fractional-indexing": "^4.0.0",
		"franc-min": "^6.2.0",
		"frimousse": "0.3.0",
		"http-status-codes": "^2.3.0",
		"lucide-react": "^1.43.0",
		"native-i18n": "0.2.0",
		"nuqs": "^2.10.1",
		"opencc-js": "1.4.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-server-dom-webpack": "19.2.8",
		"vinext": "1.0.0-beta.9"
	},
