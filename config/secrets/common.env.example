# Template for config/secrets/common.enc.env (shared + infra secrets).
# Copy to common.enc.env, fill real values, then encrypt in place:
#   cp config/secrets/common.env.example config/secrets/common.enc.env
#   sops --encrypt --in-place config/secrets/common.enc.env
# NEVER commit the plaintext; commit only the encrypted *.enc.env.
KAMAL_REGISTRY_PASSWORD=
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
PG_PASSWORD=
SECRET_KEY_BASE=
VAULT_KEY=
SEQUIN_WEBHOOK_SECRET=
# Sequin source-DB credentials (= POSTGRES_PASSWORD value in single-instance v1).
SOURCE_DB_PASSWORD=
REACTION_DB_PASSWORD=
