# Template for config/secrets/infra.enc.env (infrastructure service secrets).
# 基础设施服务密钥模板。
# Copy to infra.enc.env, fill real values, then encrypt in place:
#   cp config/secrets/infra.env.example config/secrets/infra.enc.env
#   sops --encrypt --in-place config/secrets/infra.enc.env
# NEVER commit the plaintext; commit only the encrypted *.enc.env.
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
