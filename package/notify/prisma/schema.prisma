generator client {
  provider      = "prisma-client"
  output        = "./generated"
  moduleFormat  = "esm"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgres"
}

model Notification {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  recipientId  String    @db.Uuid
  actorId      String?   @db.Uuid
  kind         String    @db.VarChar(64)
  sourceUnitId String    @db.Uuid
  extra        Json?
  read         Boolean   @default(false)
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([recipientId, read])
  @@index([recipientId, kind, sourceUnitId])
  @@index([recipientId, createdAt(sort: Desc)])
}

model Conversation {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  participantA String    @db.Uuid
  participantB String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]

  @@unique([participantA, participantB])
  @@index([participantA])
  @@index([participantB])
}

model Message {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt(sort: Desc)])
}

// Directional DM block: `blockerId` has blocked `blockedId`. A pair may have
// two rows (mutual block). Sending is disabled in either direction when a row
// exists.
model ConversationBlock {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}
