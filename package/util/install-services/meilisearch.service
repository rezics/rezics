[Unit]
Description=Meilisearch Search Engine
After=network.target

[Service]
User=www
Group=www

WorkingDirectory=/www/wwwroot/meilisearch

ExecStart=/www/wwwroot/meilisearch/meilisearch --config-file-path=/www/wwwroot/meilisearch/config.toml

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
