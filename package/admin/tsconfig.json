{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],
      "@component/*": ["./src/component/*"],
      "@page/*": ["./src/page/*"],
      "@locale": ["./src/locale/index.ts"],
      "@app/*": ["./src/app/*"]
    },
    "outDir": "./dist-types",

    "noUnusedParameters": true
  }
}
