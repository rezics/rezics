# Required
REACTION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rezics_reaction
REACTION_INTERNAL_SECRET=your-reaction-internal-secret
SERVER_JWKS_URL=http://localhost:3000/.well-known/jwks.json

# Server JWT verification
# SERVER_ISSUER=rezics-server

# Reaction types (comma-separated, defaults to upvote,downvote)
# REACTION_TYPES=upvote,downvote

# Server port (defaults to 3003)
# PORT=3003
