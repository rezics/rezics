# Required
REACTION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reaction
REACTION_INTERNAL_SECRET=your-reaction-internal-secret

# Server JWT verification (defaults shown)
# SERVER_JWKS_URL=http://localhost:3000/.well-known/jwks.json
# SERVER_ISSUER=rezics-server

# Notify service (for reaction notifications)
# NOTIFY_BASE_URL=http://localhost:3002
# NOTIFY_INTERNAL_SECRET=your-notify-internal-secret

# Main server (for owner resolution)
# SERVER_BASE_URL=http://localhost:3000
# SERVER_INTERNAL_SECRET=your-server-internal-secret

# Reaction types (comma-separated, defaults to like,dislike)
# REACTION_TYPES=like,dislike

# Server port (defaults to 3003)
# PORT=3003
