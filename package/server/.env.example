# Server Configuration
HOST=localhost
PORT=3000

# Password Hashing Configuration
# Hash algorithm: 'bf' (Blowfish), 'md5', 'des'
PASSWORD_HASH_ALGORITHM=bf

# Salt rounds for Blowfish algorithm (4-31, higher = more secure but slower)
PASSWORD_SALT_ROUNDS=12

# Optional: Custom salt (if not provided, will auto-generate)
# PASSWORD_CUSTOM_SALT=$2a$12$customsaltexample

# Database Configuration (example)
# DATABASE_URL=edgedb://localhost:5656/mydb
