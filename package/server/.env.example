NODE_ENV=development

# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_booklib?schema=public"

# ── Auth Service ──────────────────────────────────────────
# Base URL of the auth service. JWKS, issuer, and API calls are derived from this.
AUTH_BASE_URL=http://localhost:3001
# AUTH_JWT_AUDIENCE=rezics
# AUTH_JWT_CLOCK_TOLERANCE_SECONDS=5

# ── Main-Server Session JWT (bootstrap-only) ─────────────
# These seed the local JWT service record on first run.
# Steady-state uses the database-persisted key store.
# MAIN_SESSION_JWT_ISSUER=http://localhost:3000
# MAIN_SESSION_JWT_AUDIENCE=rezics
# MAIN_SESSION_JWT_PRIVATE_JWK=
# MAIN_SESSION_JWT_PUBLIC_JWK=
# MAIN_SESSION_JWT_TTL_SECONDS=3600

# ── Search ────────────────────────────────────────────────
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=masterKey

# ── SMTP (optional) ──────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_USER=user@example.com
# SMTP_USER_NAME="App Support"
# SMTP_PASSWORD=

# ── Turnstile (optional) ─────────────────────────────────
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ── Cloudflare R2 (optional) ─────────────────────────────
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# ── Internal Services ────────────────────────────────────
NOTIFY_BASE_URL=http://localhost:3002
# NOTIFY_INTERNAL_SECRET=
REACTION_BASE_URL=http://localhost:3003
# REACTION_INTERNAL_SECRET=
# SERVER_INTERNAL_SECRET=

# ── Server ────────────────────────────────────────────────
# PORT=3000
