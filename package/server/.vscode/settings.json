{
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.probe": ["**/*.{js,jsx,ts,tsx}"],
  "eslint.workingDirectories": [{"directory": ".", "changeProcessCWD": true}],
  "files.exclude": {
    "package/database/dbschema/migrations": true
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "cSpell.words": [
    "booklib",
    "Customizer",
    "datasource",
    "gtseslint",
    "postgresql",
    "prisma",
    "readlist",
    "Topbar",
    "USERPROFILE",
    "vite",
    "wouter"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma-insider"
  }
}
