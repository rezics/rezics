module default {
    scalar type short_str extending str {
        constraint max_len_value(100);
    }
    scalar type medium_str extending str {
        constraint max_len_value(1000);
    }
    scalar type long_str extending str {
        constraint max_len_value(10000);
    }
    scalar type email extending str {
        constraint min_len_value(4);
        constraint max_len_value(1000);
        constraint regexp(r'\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b');
    }

    abstract type Logger {
        required created_at: datetime {
            rewrite insert using (datetime_of_statement());
        }
        required updated_at: datetime {
            rewrite insert, update using (datetime_of_statement())
        }
    }

    type Book extending Logger {
        cover: str;
        released_at: datetime;
        last_update: datetime;

        required grabbed_from: str;
        required title: medium_str;
        required description: long_str;
        required length: bigint;

        required multi link author: Author;
        multi link units: Unit {
            constraint exclusive;
        }
        multi link platforms: Platform;
        multi link tags: Tag;
    }

    type Unit {
        required order: int32;
        required title: medium_str;
        multi link children: Unit {
            constraint exclusive;
        }
        link parent := .<children[is Unit];
        link book :=  .<units[is Book];
    }

    type Tag {
        required name: short_str;
        multi link books := .<tags[is Book];
    }

    type Platform {
        required name: medium_str;
        required domain: medium_str;
        multi link books := .<platforms[is Book];
    }

    type Author {
        required name: short_str;
        required description: medium_str;
        single link user: UserEntity;
        multi link books := .<author[is Book];
    }

    abstract type UserEntity {
        required name: short_str;
    }

    type UserProfile extending UserEntity, Logger {
        required email: email;
        description: long_str;
        multi link friends: UserProfile;
    }

    type UserGroup extending UserEntity, Logger {
        multi link members: UserProfile {
            power: int32 {
                default := 99;
                constraint min_value(0);
                constraint max_value(99);
            }
        }
    }
    
    type Message extending Logger {
        required link sender: UserEntity;
        required link receiver: UserEntity;
        required content: long_str;
    }

    type Thread extending Logger {
        required link author: UserEntity;
        required content: long_str;

        multi link related: Tag | Book;
        multi link replies: Thread;
    }
}
