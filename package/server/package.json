{
  "name": "@package/server",
  "module": "src/export.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/export.ts",
      "default": "./src/export.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "dev": "bun run --watch --no-cache src/index.ts",
    "dev:cluster": "bun run --watch --no-cache src/cluster.ts",
    "build": "bun build src/index.ts --compile --minify-whitespace --minify-syntax --target bun --outfile server",
    "build:linux": "bun build src/cluster.ts --compile --minify-whitespace --minify-syntax --target bun-linux-x64 --outfile server",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev && bun run prisma:generate",
    "prisma:deploy": "bunx prisma migrate deploy && bun run prisma:generate",
    "prisma:studio": "bunx prisma studio",
    "seed:mock": "bun run prisma/seed/mock/seed.ts",
    "seed:mock:echokv": "bun run prisma/seed/mock/echokv.ts",
    "seed:databaseReset": "bun run prisma/seed/utils/databaseReset.ts",
    "seed:init-meili-search": "bun run prisma/seed/utils/init-meili-search.ts",
    "db:migrate": "bun run prisma/db/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.6.0",
    "prisma-json-types-generator": "^4.1.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.14",
    "@faker-js/faker": "^10.1.0",
    "@package/contract": "workspace:*",
    "@package/cors": "workspace:*",
    "@package/jwt": "workspace:*",
    "@package/search": "workspace:*",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.22",
    "jose": "^6.2.0",
    "pg": "^8.16.3"
  }
}
