{
  "name": "@package/server",
  "module": "src/export.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/export.ts",
      "default": "./src/export.ts"
    }
  },
  "scripts": {
    "dev": "bun run --watch --no-cache src/index.ts",
    "dev:cluster": "bun run --watch --no-cache src/cluster.ts",
    "build": "bun build \t--compile \t--minify-whitespace \t--minify-syntax \t--target bun \t--outfile server \tsrc/index.ts",
    "build:linux": "bun build \t--compile \t--minify-whitespace \t--minify-syntax \t--target bun-linux-x64 \t--outfile server \tsrc/cluster.ts",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:deploy": "bunx prisma migrate deploy",
    "prisma:studio": "bunx prisma studio",
    "prisma:seed": "bun run prisma/seed.ts",
    "prisma:seed:echokv": "bun run prisma/seed/echokv.ts",
    "prisma:seed:passwordReset": "bun run prisma/seed/utils/passwordReset.ts",
    "prisma:seed:databaseReset": "bun run prisma/seed/utils/databaseReset.ts",
    "db:migrate": "bun run prisma/db/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.15.5",
    "prisma": "^6.17.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.1",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "@faker-js/faker": "^10.1.0",
    "@package/contract": "workspace:*",
    "@package/search": "workspace:*",
    "@prisma/adapter-pg": "^6.17.1",
    "@prisma/client": "^6.17.1",
    "@types/bcrypt": "^6.0.0",
    "@types/nodemailer": "^7.0.4",
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.12",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "resend": "^6.5.2",
    "uuid": "^13.0.0"
  }
}
