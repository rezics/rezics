{
  "name": "@rezics/server",
  "module": "src/export.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/export.ts",
      "default": "./src/export.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./prisma/seed": {
      "types": "./prisma/seed/index.ts",
      "default": "./prisma/seed/index.ts"
    },
    "./prisma/factory": {
      "types": "./prisma/factory/index.ts",
      "default": "./prisma/factory/index.ts"
    },
    "./prisma/*": {
      "types": "./prisma/*.ts",
      "default": "./prisma/*.ts"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch --no-cache src/index.ts",
    "dev:cluster": "NODE_ENV=development bun run --watch --no-cache src/cluster.ts",
    "build": "bun build src/index.ts --compile --minify-whitespace --minify-syntax --target bun --outfile server",
    "build:linux": "bun build src/cluster.ts --compile --minify-whitespace --minify-syntax --target bun-linux-x64 --outfile server",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:deploy": "bunx prisma migrate deploy && bun run prisma:generate",
    "prisma:studio": "bunx prisma studio",
    "seed:factory": "bun run ../../package/utils/bin/cli.ts factory --preset=realistic --no-interactive",
    "seed:factory:fast": "bun run ../../package/utils/bin/cli.ts factory --preset=fast --no-interactive",
    "seed:factory:echokv": "bun run ../../package/utils/bin/cli.ts factory --only=echokv --no-interactive",
    "seed:database-reset": "bun run ../../package/utils/bin/cli.ts db reset",
    "seed:database-reset:all": "bun run ../../package/utils/bin/cli.ts db reset --all",
    "seed:init-meili-search": "bun run ../../package/utils/bin/cli.ts db init-meili"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.8.0",
    "prisma-json-types-generator": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.14",
    "@faker-js/faker": "^10.1.0",
    "@rezics/contract": "workspace:*",
    "@rezics/jwt": "workspace:*",
    "@rezics/search": "workspace:*",
    "@rezics/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.22",
    "jose": "^6.2.0",
    "pg": "^8.16.3"
  }
}
