/// Generic attention edge from a subscriber Unit (USER in v1) to any
/// target Unit. `channels` is a String[] filter using dot-namespaced
/// events with three wildcard tiers (`'*'`, `'<category>.*'`,
/// `'<category>.<event>'`); see `@rezics/contract` `CHANNEL_REGISTRY`
/// for the per-target-type registry. The fan-out resolver in
/// `notify-boundary` performs three GIN-indexable array-containment
/// checks against `channels`. The GIN index is added via raw SQL in
/// the migration since Prisma does not yet model GIN.
model Subscription {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subscriberUnitId String   @db.Uuid
  targetUnitId     String   @db.Uuid
  channels         String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriber Unit @relation("SubscriptionSubscriber", fields: [subscriberUnitId], references: [id], onDelete: Cascade)
  target     Unit @relation("SubscriptionTarget", fields: [targetUnitId], references: [id], onDelete: Cascade)

  @@unique([subscriberUnitId, targetUnitId])
  @@index([targetUnitId])
  @@index([subscriberUnitId])
  @@index([channels], type: Gin, map: "subscription_channels_gin")
}

