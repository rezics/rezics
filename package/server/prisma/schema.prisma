  linkedCase     ModerationCase?        @relation(fields: [linkedCaseId], references: [id], onDelete: SetNull)
  assignedTo     User?                  @relation("RealmModerationQueueAssignedTo", fields: [assignedToUserId], references: [unitId], onDelete: SetNull)
  events         RealmModerationEvent[]

  @@index([realmUnitId, state, createdAt])
  @@index([realmUnitId, assignedToUserId, state, createdAt], map: "RealmModerationQueueItem_realmUnitId_assignedToUserId_state_idx")
  @@index([targetKind, targetId])
  @@index([targetUnitId, state])
  @@index([subjectUserId, state, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([sourceFeedbackId])
  @@index([linkedCaseId])
