generator client {
  provider      = "prisma-client"
  output        = "./generated"
  moduleFormat  = "esm"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgres"
}

/**
 * ANCHOR ENUMS
 */

enum UnitType {
  BOOK
  GAME
  MEDIA
  POST
  TAG
  REALM
  SHELF
  SERIES
  IMAGE
  VIDEO
  QUOTE
  LINK
  LABEL
  POLL
  ENTITY
  ZONE
  /// Type-extension marker for User rows. `User.unitId` equals the corresponding `Unit.id`.
  USER
  /// Placeholder Unit backing a row in `SlugScope`. SCOPE units have `slug = null` and their `id` is the value of `Unit.slugScope` for every top-level slug under that scope.
  SCOPE
}

enum UnitStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum UnitVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum ContentRating {
  GENERAL
  R_15
  R_18
  R_18G
}

enum AiDisclosureMode {
  UNKNOWN
  NONE
  AI_ASSISTED
  AI_ORIGINATED
  MACHINE_GENERATED
}

enum UserUnitProgressStatus {
  BACKLOG
  ACTIVE
  PAUSED
  COMPLETED
  DROPPED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum UnitWorkRole {
  RELEASE
  POST
  REVIEW
  SHELF
  SERIES
  WIKI
  GUIDE
  DERIVED
}

enum UnitWorkDisplayPolicy {
  PRIMARY
  SECONDARY
  HIDDEN_BY_DEFAULT
}

enum UnitAliasKind {
  COMMON
  ABBREVIATION
  TRANSLITERATION
  ALTERNATE_TITLE
  LEGACY_TITLE
  MISSPELLING
  OTHER
}

enum UnitAliasStatus {
  ACTIVE
  HIDDEN
}

enum PostKind {
  /**
   * Long-form review with rating.
   * Structured, in-depth content (e.g. like review from professional connoisseurs).
   */
  REVIEW
  /**
   * A user-highlighted passage from the work named by `targetUnitId` (e.g., memorable sentences from books or lines from games).
   */
  EXCERPT
  /**
   * Remark: casual and unrestricted user review.
   * No word limit
   */
  REMARK
  /**
   * Because PostTree does not currently support the UnitVisibility setting
   */
  POST
  /**
   * A chapter of the book named by `targetUnitId` (a Unit of type=BOOK).
   * Content lives in `Post.content`; cover (optional) lives in `UnitTranslation.extra.coverUrl`.
   * Order is governed by `ContentStructureNode` rows.
   */
  CHAPTER
  /**
   * Collaborative wiki-style post content. Field protection is handled through
   * UnitFieldLock, not Post.isLocked.
   */
  WIKI
}

/**
 * ANCHOR CORE: UNIT IDENTITY
 */

model Unit {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type      UnitType
  slug      String?
  /// Slug-namespace key. Points at the placeholder Unit for one of the five
  /// named scopes (user / realm / tag / zone / entity) for top-level slugs, or
  /// at an owner Unit's id for owner-scoped sub-resources (e.g. shelves under
  /// a user). NOT NULL, no FK constraint declared (matches the polymorphic-
  /// shaped-column convention used by ShelfUnit / ShelfItem).
  slugScope String   @db.Uuid
  userId    String?  @db.Uuid

  defaultLanguage   String? @db.VarChar(16)
  /// Language-independent units (e.g. TAG). When true, the unit bypasses
  /// `UnitSupportLanguage` and matches any language filter.
  isLanguageNeutral Boolean @default(false)

  status     UnitStatus     @default(DRAFT)
  visibility UnitVisibility @default(PUBLIC)
  rating     ContentRating  @default(GENERAL)

  /// Declared AI involvement/provenance for this Unit's public-facing content.
  /// Defaults to UNKNOWN because historical data must not imply a no-AI claim.
  aiDisclosureMode    AiDisclosureMode @default(UNKNOWN)
  aiDisclosureDetails Json?

  /// Publication license slug from the contract registry. Nullable for
  /// backward-compatible rollout; readers may treat null as the platform
  /// default when an effective license is required.
  licenseSlug String?

  /// Denormalized count of `Subscription` rows targeting this unit.
  /// Maintained transactionally by the subscription service alongside row
  /// insert/delete. Powers Unit-detail render of "N watchers" without a
  /// COUNT(*) on every read. Drift is mitigated by the migration recompute.
  subscriberCount Int @default(0)

  extra Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Cross-user work-release claim flow (see WorkLinkClaim).
  releaseClaims   WorkLinkClaim[] @relation("WorkLinkClaimRelease")
  workClaims      WorkLinkClaim[] @relation("WorkLinkClaimWork")
  workMemberships UnitWork[]      @relation("UnitWorkMember")
  workMembers     UnitWork[]      @relation("UnitWorkWork")
  workRealmContextsAsWork    WorkRealmContext[] @relation("WorkRealmContextWork")
  workRealmContextsAsRealm   WorkRealmContext[] @relation("WorkRealmContextRealm")
  workRealmContextsAsRelease WorkRealmContext[] @relation("WorkRealmContextRelease")

  // Owner/creator
  user User? @relation("UnitForUser", fields: [userId], references: [unitId])

  // Translation layer
  translations     UnitTranslation[]
  supportLanguages UnitSupportLanguage[]
  aliases          UnitAlias[]           @relation("UnitAliases")

  // Parallel-translation grouping (POST wiki flow); see TranslationGroup.
  translationGroupId String?           @db.Uuid
  translationGroup   TranslationGroup? @relation(fields: [translationGroupId], references: [id], onDelete: SetNull)

  // Type extensions (1:1, optional)
  book   Book?
  game   Game?
  media  Media?
  post   Post?
  shelf  Shelf?
  series Series?
  realm  Realm?
  link   Link?
  entity Entity?
  zone   Zone?
  poll   Poll?

  // Tag system
  unitTags       UnitTag[] @relation("TaggedUnit")
  tagUsages      UnitTag[] @relation("UnitTagAppliedTag")
  tagVotesOnUnit TagVote[] @relation("TagVoteUnit")
  tagVotesAsTag  TagVote[] @relation("TagVoteTag")

  // Poll options that reference this Unit as their subject (vote-for-a-unit)
  pollOptionsAsUnit PollOption[] @relation("PollOptionUnit")

  // Realm organization
  realmContent UnitRealm[] @relation("RealmContent")
  inRealms     UnitRealm[] @relation("UnitInRealm")

  // Realm-scoped tag classification. The realm side is exposed through
  // `Realm`; Unit keeps only the global tag, target content, and context
  // content roles because TAG/content do not have dedicated extension models.
  realmTagApplicationsAsAppliedTag RealmTagApplication[] @relation("RealmTagApplicationAppliedTag")
  realmTagApplicationsAsTargetUnit RealmTagApplication[] @relation("RealmTagApplicationTargetUnit")
  realmTagContextsAsTag            RealmTagContext[]     @relation("RealmTagContextTag")
  realmTagContextsAsContent        RealmTagContext[]     @relation("RealmTagContextContent")

  // Credit attribution
  creditAttributions            CreditAttribution[]  @relation("CreditAttributedUnit")
  creditedAs                    CreditAttribution[]  @relation("CreditAttributionEntity")
  externalRefs                  UnitExternalRef[]    @relation("UnitExternalRefUnit")
  seriesContentIndexesAsRelease SeriesContentIndex[] @relation("SeriesContentIndexRelease")

  // Subject attribution
  subjectAttributions             SubjectAttribution[]       @relation("SubjectAttributedUnit")
  subjectOfAttributions           SubjectAttribution[]       @relation("SubjectAttributionEntity")
  gameSystemRequirementPlatforms  GameSystemRequirement[]    @relation("GameSystemRequirementPlatformEntity")

  // Engagement (reactions moved to @rezics/reaction service)

  // Post relations (other posts referencing this unit)
  targetedByPosts Post[] @relation("PostTarget")
  rootPosts       Post[] @relation("PostRoot")
  parentPosts     Post[] @relation("PostParent")

  // PostPin promotion overlay (scope is always a thread root post; target a reply)
  postPinsAsScope PostPin[] @relation("PostPinScope")
  postPinsAsPost  PostPin[] @relation("PostPinPost")

  userProgress UserUnitProgress[] @relation("ProgressUnit")

  // Subscription edges (see Subscription model). `subscribers` are rows
  // where this Unit is the target; `subscriptionsMade` are rows where
  // this Unit (in v1: a USER Unit) is the subscriber.
  subscribers       Subscription[] @relation("SubscriptionTarget")
  subscriptionsMade Subscription[] @relation("SubscriptionSubscriber")

  realmRuleAcknowledgements RealmRuleAcknowledgement[] @relation("RealmRuleAcknowledgementRuleUnit")

  staffCapabilityGrantRealms StaffGrant[]               @relation("StaffGrantRealm")
  moderationCaseTargets      ModerationCase[]           @relation("ModerationCaseTargetUnit")
  moderationCaseRealms       ModerationCase[]           @relation("ModerationCaseRealm")
  realmQueueTargets          RealmModerationQueueItem[] @relation("RealmModerationQueueTargetUnit")
  contentModerationState     ContentModerationState?
  realmModerationTargets     RealmContentModeration[]   @relation("RealmContentModerationTargetUnit")

  // Collaborative authority and history capture.
  collaborators UnitCollaborator[]
  fieldLocks    UnitFieldLock[]
  historyClock  UnitHistoryClock?
  historyOutbox HistoryOutbox[]

  // Inverse of ContentStructure.ownerUnitId — every generic content tree
  // owned by this Unit.
  ownedContentStructure          ContentStructure?
  // Inverse of ContentStructureNode.contentUnitId — every content-structure
  // node that references this Unit as concrete content.
  contentStructureNodesAsContent ContentStructureNode[] @relation("ContentStructureNodeContent")

  @@unique([slugScope, slug])
  @@unique([translationGroupId, defaultLanguage])
  @@index([type, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, visibility])
  @@index([defaultLanguage])
  @@index([translationGroupId])
  @@index([slugScope, type])
}

/**
 * ANCHOR SLUG SCOPE
 * Lookup table mapping one of the five named scope keys (`user`, `realm`,
 * `tag`, `zone`, `entity`) to the placeholder `Unit { type: SCOPE }` row whose
 * id is used as `Unit.slugScope` for every top-level slug under that scope.
 * Owner-scoped sub-resources (e.g. shelves under a user) bypass this table
 * and use the owner Unit's id directly as `slugScope`.
 */
model SlugScope {
  /// Named scope key. The five allowed values are seeded once at infra bootstrap.
  slug   String @id
  /// Placeholder Unit (type = SCOPE) whose id is the slugScope value for top-level slugs in this scope.
  unitId String @unique @db.Uuid
}

/**
 * ANCHOR PARALLEL TRANSLATION GROUPING
 */

/// Aggregates parallel-translation sibling Units (e.g. wiki-style POSTs in multiple languages).
/// `supportedLanguages` is a denormalized cache of each member's `defaultLanguage`, maintained transactionally on attach/detach to avoid per-render JOINs at scale.
model TranslationGroup {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  supportedLanguages String[] @db.VarChar(16)
  createdAt          DateTime @default(now())

  units Unit[]
}

/**
 * ANCHOR TRANSLATION LAYER
 */

model UnitTranslation {
  unitId   String @db.Uuid
  language String @db.VarChar(16)

  title       String?
  subtitle    String?
  summary     String?
  /// Rich ContentDoc JSON. Search projections such as descriptionText are
  /// Meilisearch-only and must not be added as PostgreSQL columns.
  description Json?
  extra       Json?

  // Optional provenance Unit for the translation's display/content source.
  sourceUnitId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([unitId, language])
  @@index([language, title])
}

model UnitSupportLanguage {
  unitId    String  @db.Uuid
  language  String  @db.VarChar(16)
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([unitId, language])
  @@index([language, unitId])
}

/**
 * ANCHOR UNIT ALIAS SEARCH
 */

model UnitAlias {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  unitId          String          @db.Uuid
  value           String
  normalizedValue String
  language        String?         @db.VarChar(16)
  kind            UnitAliasKind   @default(COMMON)
  status          UnitAliasStatus @default(ACTIVE)
  score           Int             @default(0)
  voteCount       Int             @default(0)
  pinned          Boolean         @default(false)
  position        String?
  createdById     String?         @db.Uuid
  updatedById     String?         @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit      Unit            @relation("UnitAliases", fields: [unitId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("UnitAliasCreatedBy", fields: [createdById], references: [unitId], onDelete: SetNull)
  updatedBy User?           @relation("UnitAliasUpdatedBy", fields: [updatedById], references: [unitId], onDelete: SetNull)
  votes     UnitAliasVote[] @relation("UnitAliasVotes")

  @@unique([unitId, normalizedValue])
  @@index([normalizedValue])
  @@index([unitId, pinned, position])
  @@index([unitId, status, score])
  @@index([status, score])
  @@index([createdById, createdAt])
}

model UnitAliasVote {
  aliasId String @db.Uuid
  userId  String @db.Uuid
  value   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alias UnitAlias @relation("UnitAliasVotes", fields: [aliasId], references: [id], onDelete: Cascade)
  user  User      @relation("UnitAliasVoteUser", fields: [userId], references: [unitId], onDelete: Cascade)

  @@id([aliasId, userId])
  @@index([userId])
}

/**
 * ANCHOR WORK-LINK CLAIM
 * Cross-user work/release linkage approval.
 */

model WorkLinkClaim {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  releaseUnitId String      @db.Uuid
  workUnitId    String      @db.Uuid
  claimerUserId String      @db.Uuid
  status        ClaimStatus @default(PENDING)
  rejectReason  String?
  createdAt     DateTime    @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?     @db.Uuid

  releaseUnit Unit  @relation("WorkLinkClaimRelease", fields: [releaseUnitId], references: [id], onDelete: Cascade)
  workUnit    Unit  @relation("WorkLinkClaimWork", fields: [workUnitId], references: [id], onDelete: Cascade)
  claimer     User  @relation("WorkLinkClaimClaimer", fields: [claimerUserId], references: [unitId])
  resolver    User? @relation("WorkLinkClaimResolver", fields: [resolvedBy], references: [unitId])

  @@index([workUnitId, status])
  @@index([claimerUserId, status])
  @@index([releaseUnitId, status])
}

/**
 * ANCHOR UNIT WORK DOMAIN
 * Canonical relation between any Unit participating in a work domain and the
 * hidden work Unit that owns grouping, inherited discovery metadata, and shared
 * content aggregation.
 */
model UnitWork {
  unitId        String                @db.Uuid
  workUnitId    String                @db.Uuid
  role          UnitWorkRole
  language      String?               @db.VarChar(16)
  position      String?               @db.VarChar(64)
  displayPolicy UnitWorkDisplayPolicy @default(PRIMARY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit Unit @relation("UnitWorkMember", fields: [unitId], references: [id], onDelete: Cascade)
  work Unit @relation("UnitWorkWork", fields: [workUnitId], references: [id], onDelete: Cascade)

  @@id([unitId, workUnitId, role])
  @@index([workUnitId, role, position, unitId])
  @@index([workUnitId, role, createdAt, unitId])
  @@index([unitId, role, workUnitId])
}

model WorkRealmContext {
  id            String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workUnitId    String  @db.Uuid
  realmUnitId   String  @db.Uuid
  role          String  @db.VarChar(32)
  priority      Int     @default(0)
  locale        String? @db.VarChar(16)
  releaseUnitId String? @db.Uuid

  createdByUserId String? @db.Uuid
  updatedByUserId String? @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  work        Unit  @relation("WorkRealmContextWork", fields: [workUnitId], references: [id], onDelete: Cascade)
  realm       Unit  @relation("WorkRealmContextRealm", fields: [realmUnitId], references: [id], onDelete: Cascade)
  releaseUnit Unit? @relation("WorkRealmContextRelease", fields: [releaseUnitId], references: [id], onDelete: SetNull)

  @@index([workUnitId, role, priority, id])
  @@index([realmUnitId, role, priority, id])
  @@index([releaseUnitId, role])
}

/**
 * ANCHOR ADMIN WORK MERGE
 * Durable audit and revert log for admin-only work-domain canonical merges.
 * The source work Unit is preserved; this row records moved memberships,
 * legacy release pointers, optional metadata copies, repair enqueue counts,
 * and item-level progress.
 */
model AdminWorkMergeOperation {
  id                        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sourceWorkUnitId          String    @db.Uuid
  targetWorkUnitId          String    @db.Uuid
  status                    String    @default("QUEUED") @db.VarChar(32)
  actorUserId               String    @db.Uuid
  reason                    String?
  copyTagsRequested         Boolean   @default(false)
  copyAliasesRequested      Boolean   @default(false)
  itemProgress              Json      @default("{}")
  movedMemberships          Json      @default("[]")
  movedLegacyReleaseUnitIds String[]  @default([])
  createdTagKeys            String[]  @default([])
  createdAliasIds           String[]  @default([])
  repairUnitIds             String[]  @default([])
  repairCommandCount        Int       @default(0)
  errorMessage              String?
  revertedAt                DateTime?
  revertedByUserId          String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actor      User  @relation("AdminWorkMergeActor", fields: [actorUserId], references: [unitId], onDelete: Restrict)
  revertedBy User? @relation("AdminWorkMergeRevertedBy", fields: [revertedByUserId], references: [unitId], onDelete: SetNull)

  @@index([sourceWorkUnitId, status, createdAt])
  @@index([targetWorkUnitId, status, createdAt])
  @@index([actorUserId, createdAt])
}

/**
 * ANCHOR BOOK EXTENSION
 */

model Book {
  unitId String @id @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  isbn13          String?   @db.VarChar(32)
  publicationDate DateTime?
  pageCount       Int?
  textLength      Int       @default(0)
  chapterCount    Int       @default(0)
  formatKey       String?   @db.VarChar(32)
  isLicensed      Boolean   @default(false)

  extra Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isbn13])
  @@index([publicationDate])
}

model ContentStructure {
  ownerUnitId String   @id @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        Unit                   @relation(fields: [ownerUnitId], references: [id], onDelete: Cascade)
  contentNodes ContentStructureNode[] @relation("ContentStructureContainer")

  @@index([updatedAt(sort: Desc)])
}

/// One row per node in a ContentStructure tree.
/// - `id`: globally unique node identity.
/// - `contentUnitId`: not unique; the same Unit can be referenced by many nodes.
/// - `sortKey`: orders siblings within each `(ownerUnitId, parentId)` group.
/// Because of that reuse, the node `id` — not `contentUnitId` — is the canonical
/// reading address (`lastReadNodeId`, materialize, the read route): only the node
/// id says which occurrence the reader is at, and it is stable under TOC reorder.
model ContentStructureNode {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerUnitId   String         @db.Uuid
  parentId      String?        @db.Uuid
  sortKey       String
  contentUnitId String?        @db.Uuid
  title         String
  noContent     Boolean        @default(false)
  rating        ContentRating?
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  container            ContentStructure          @relation("ContentStructureContainer", fields: [ownerUnitId], references: [ownerUnitId], onDelete: Cascade)
  parent               ContentStructureNode?     @relation("ContentStructureNodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children             ContentStructureNode[]    @relation("ContentStructureNodeChildren")
  contentUnit          Unit?                     @relation("ContentStructureNodeContent", fields: [contentUnitId], references: [id], onDelete: SetNull)
  seriesContentIndex   SeriesContentIndex?
  userProgressLastNode UserUnitProgress[]        @relation("UserUnitProgressLastNode")
  userNodeProgress     UserContentNodeProgress[]

  @@index([ownerUnitId, parentId, sortKey, isDeleted])
  @@index([contentUnitId])
  @@index([ownerUnitId, updatedAt(sort: Desc)])
  @@index([ownerUnitId, isDeleted, updatedAt(sort: Desc)])
}

/**
 * ANCHOR GAME EXTENSION
 */

model Game {
  unitId String @id @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  releaseDate  DateTime?
  versionLabel String?
  /// Legacy import field. New writes use UnitTag rating TAG Units; retained only until legacy backfill and read migration are complete.
  ageRatingKey String?   @db.VarChar(32)
  isLicensed   Boolean   @default(false)

  extra Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platforms          GamePlatform[]
  systemRequirements GameSystemRequirement[]
}

/// Legacy platform junction. New writes use SubjectAttribution(role = "available_on") to platform Entity Units; retained only for backfill.
model GamePlatform {
  gameUnitId  String @db.Uuid
  platformKey String @db.VarChar(64)
  sortOrder   Int    @default(0)

  game Game @relation(fields: [gameUnitId], references: [unitId], onDelete: Cascade)

  @@id([gameUnitId, platformKey])
  @@index([platformKey, gameUnitId])
}

model GameSystemRequirement {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  gameUnitId       String   @db.Uuid
  platformEntityId String?  @db.Uuid
  tier             String   @db.VarChar(32)
  language         String?  @db.VarChar(16)
  sourceRefId      String?  @db.Uuid
  hardware         Json
  rawText          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  game           Game             @relation(fields: [gameUnitId], references: [unitId], onDelete: Cascade)
  platformEntity Unit?            @relation("GameSystemRequirementPlatformEntity", fields: [platformEntityId], references: [id], onDelete: SetNull)
  sourceRef      UnitExternalRef? @relation("GameSystemRequirementSourceRef", fields: [sourceRefId], references: [id], onDelete: SetNull)

  @@index([gameUnitId])
  @@index([platformEntityId])
  @@index([tier])
  @@index([sourceRefId])
  @@index([gameUnitId, platformEntityId, tier, sourceRefId])
}

/**
 * ANCHOR MEDIA EXTENSION
 */

model Media {
  unitId String @id @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  kindKey        String    @db.VarChar(32)
  releaseDate    DateTime?
  runtimeMinutes Int?
  episodeCount   Int?
  seasonCount    Int?
  isLicensed     Boolean   @default(false)

  extra Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kindKey, releaseDate])
}

/**
 * ANCHOR LINK EXTENSION
 */

model Link {
  unitId String @id @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  url        String
  siteName   String? @db.VarChar(128)
  faviconUrl String?

  extra Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ANCHOR POST EXTENSION
 * Replaces Comment, Review, Note, and Remark.
 */

model Post {
  unitId String @id @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  authorUserId String @db.Uuid

  targetUnitId       String? @db.Uuid
  rootTargetUnitId   String? @db.Uuid
  rootTargetUnitType String? @db.VarChar(32)
  scoreEntryId       String? @db.Uuid

  /// Canonical ContentDoc JSON. Search projections such as contentText are
  /// Meilisearch-only and must not be added as PostgreSQL columns.
  content Json?

  rootPostUnitId   String? @db.Uuid
  parentPostUnitId String? @db.Uuid

  kind PostKind?

  depth Int @default(0)

  /// Postgres-native ltree materialized path from the thread root to this post.
  /// Modeled as Unsupported: read and written via raw SQL only. The GiST index
  /// backing subtree containment is owned by a manual migration, not Prisma
  /// (see the manual_redesign_post_ltree_index migration). The legacy
  /// zero-padded `sortPath` VARCHAR column is gone; topology and depth live
  /// here, while presentation order is a DB ORDER BY key (School B).
  path Unsupported("ltree")?

  replyCount       Int       @default(0)
  directReplyCount Int       @default(0)
  lastReplyAt      DateTime?
  isLocked         Boolean   @default(false)

  /// Lifecycle label: a kebab-case slug (e.g. `open`, `solved`, `not-planned`)
  /// drawn from the schema named by `extra.stateSchemaTag`. Behaviorally inert —
  /// it gates nothing (reply permission reads `isLocked`, visibility reads
  /// `Unit.status`); it is read-lenient (any slug) and write-strict (validated
  /// against the schema). Null means "no lifecycle". `extra.stateSchemaTag`
  /// snapshots the governing tag slug at creation and does not drift.
  state String?

  extra Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targetUnit Unit?       @relation("PostTarget", fields: [targetUnitId], references: [id], onDelete: SetNull)
  rootPost   Unit?       @relation("PostRoot", fields: [rootPostUnitId], references: [id], onDelete: SetNull)
  parentPost Unit?       @relation("PostParent", fields: [parentPostUnitId], references: [id], onDelete: SetNull)
  scoreEntry ScoreEntry? @relation("PostScoreEntry", fields: [scoreEntryId], references: [id], onDelete: Restrict)

  @@index([authorUserId, createdAt])
  @@index([targetUnitId, createdAt])
  @@index([rootPostUnitId, createdAt])
  @@index([parentPostUnitId, createdAt])
  @@index([kind, createdAt])
  @@index([scoreEntryId])
  @@index([rootTargetUnitId, createdAt])
  // Bucket filtering for lifecycle listings (e.g. unsolved questions): a cheap
  // `state IN (active|closed slugs)` IN-list, no anti-join. Scoped by
  // rootTargetUnitId so target/realm feeds hit the index.
  @@index([rootTargetUnitId, state])
}

/// Why a post is promoted within a thread. `HIGHLIGHT` is reserved for future
/// use; only `ACCEPTED_ANSWER` and `PINNED` are produced today.
enum PinKind {
  ACCEPTED_ANSWER
  PINNED
  HIGHLIGHT
}

/**
 * POST PROMOTION OVERLAY
 *
 * Generic in-thread promotion of a reply, mirroring the pinned/position idiom
 * of `RealmTagApplication`, `UnitTag`, and `ShelfUnit`. `scopeUnitId` is ALWAYS
 * the thread root post; the target `postUnitId` is ALWAYS a reply within that
 * thread (`depth >= 1`, `rootPostUnitId == scopeUnitId`). A realm is never a
 * scope — realm-level featuring of whole units is `Realm.extra.pinboard`'s job.
 */
model PostPin {
  scopeUnitId String  @db.Uuid
  postUnitId  String  @db.Uuid
  kind        PinKind
  position    String  @db.VarChar(64) // Fractional Indexing
  byUserId    String  @db.Uuid

  createdAt DateTime @default(now())

  scope Unit @relation("PostPinScope", fields: [scopeUnitId], references: [id], onDelete: Cascade)
  post  Unit @relation("PostPinPost", fields: [postUnitId], references: [id], onDelete: Cascade)

  @@id([scopeUnitId, postUnitId])
  @@index([scopeUnitId, kind, position])
  @@index([postUnitId])
}

/**
 * ANCHOR SHELF EXTENSION
 * Replaces ReadList and Series.
 */

model Shelf {
  unitId String @id @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  kindKey   String? @db.VarChar(64)
  extra     Json?
  itemCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units     ShelfUnit[]
  relations ShelfUnitRelation[]
}

model ShelfUnit {
  shelfId  String @db.Uuid
  unitId   String @db.Uuid
  kind     String @db.VarChar(32)
  position String @db.VarChar(64) // Fractional Indexing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shelf           Shelf               @relation(fields: [shelfId], references: [unitId], onDelete: Cascade)
  parentRelations ShelfUnitRelation[] @relation("ShelfUnitRelationParent")
  childRelations  ShelfUnitRelation[] @relation("ShelfUnitRelationChild")

  @@id([shelfId, unitId])
  @@index([shelfId, position])
}

model ShelfUnitRelation {
  shelfId      String @db.Uuid
  parentUnitId String @db.Uuid
  childUnitId  String @db.Uuid
  role         String @db.VarChar(32)

  shelf  Shelf     @relation(fields: [shelfId], references: [unitId], onDelete: Cascade)
  parent ShelfUnit @relation("ShelfUnitRelationParent", fields: [shelfId, parentUnitId], references: [shelfId, unitId], onDelete: Cascade)
  child  ShelfUnit @relation("ShelfUnitRelationChild", fields: [shelfId, childUnitId], references: [shelfId, unitId], onDelete: Cascade)

  @@id([shelfId, parentUnitId, childUnitId, role])
  @@index([shelfId, parentUnitId, role])
  @@index([shelfId, childUnitId])
  @@index([childUnitId, role])
  @@index([parentUnitId, role])
}

/**
 * ANCHOR SERIES EXTENSION
 */

model Series {
  unitId String @id @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  /// Public-knowledge grouping kind. Contract values are defined by
  /// SeriesKind in @rezics/contract.
  kindKey String @db.VarChar(64)
  extra   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  directReleaseIndexRows SeriesContentIndex[]

  @@index([kindKey])
  @@index([updatedAt(sort: Desc)])
}

/// Direct lookup projection from counted release member nodes in generic
/// ContentStructure. This model intentionally stores no path, depth, ordering,
/// hierarchy, Work Unit, inherited-membership, or work-domain source fields.
model SeriesContentIndex {
  seriesUnitId  String @db.Uuid
  releaseUnitId String @db.Uuid
  contentNodeId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series      Series               @relation(fields: [seriesUnitId], references: [unitId], onDelete: Cascade)
  releaseUnit Unit                 @relation("SeriesContentIndexRelease", fields: [releaseUnitId], references: [id], onDelete: Cascade)
  contentNode ContentStructureNode @relation(fields: [contentNodeId], references: [id], onDelete: Cascade)

  @@id([seriesUnitId, releaseUnitId, contentNodeId])
  @@unique([contentNodeId])
  @@index([seriesUnitId, releaseUnitId])
  @@index([releaseUnitId, seriesUnitId])
}

/**
 * ANCHOR REALM EXTENSION
 */

model Realm {
  unitId String @id @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  isPublic    Boolean @default(true)
  isOfficial  Boolean @default(false)
  memberCount Int     @default(0)

  extra Json?

  /// Versioned rule policy for the POST Unit referenced by Realm.extra.rule.
  ruleVersion         Int       @default(1)
  ruleRequireOnJoin   Boolean   @default(false)
  ruleRequireOnPost   Boolean   @default(false)
  ruleRequireOnUpdate Boolean   @default(true)
  rulePolicyUpdatedAt DateTime?

  /// When true, new joins are stored as pending until a realm moderator approves them.
  joinRequiresApproval Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members              RealmMember[]
  ruleAcknowledgements RealmRuleAcknowledgement[]

  /// Realm is a subreddit-like community space, not a tag or classifier.
  /// It owns membership and community metadata; realm-scoped tag classification lives in RealmTagApplication and RealmTagContext.
  tagApplications      RealmTagApplication[]      @relation("RealmTagApplicationRealm")
  tagContexts          RealmTagContext[]
  capabilityGrants     RealmCapabilityGrant[]
  moderationQueueItems RealmModerationQueueItem[]
  moderationOverlays   RealmContentModeration[]
}

model RealmMember {
  realmUnitId String           @db.Uuid
  userId      String           @db.Uuid
  roleKey     String           @db.VarChar(32)
  state       RealmMemberState @default(ACTIVE)

  onboardingCompletedAt DateTime?
  joinedAt              DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  realm            Realm                  @relation(fields: [realmUnitId], references: [unitId], onDelete: Cascade)
  capabilityGrants RealmCapabilityGrant[]

  @@id([realmUnitId, userId])
  @@index([userId])
  @@index([realmUnitId, roleKey])
  @@index([realmUnitId, state])
}

model RealmRuleAcknowledgement {
  realmUnitId      String   @db.Uuid
  ruleUnitId       String   @db.Uuid
  version          Int
  userId           String   @db.Uuid
  acceptedLanguage String?  @db.VarChar(16)
  acceptedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  realm    Realm @relation(fields: [realmUnitId], references: [unitId], onDelete: Cascade)
  ruleUnit Unit  @relation("RealmRuleAcknowledgementRuleUnit", fields: [ruleUnitId], references: [id], onDelete: Cascade)
  user     User  @relation(fields: [userId], references: [unitId], onDelete: Cascade)

  @@id([realmUnitId, ruleUnitId, version, userId])
  @@index([userId, acceptedAt])
  @@index([realmUnitId, userId, acceptedAt])
}

/**
 * ANCHOR REALM ORGANIZATION
 */

model UnitRealm {
  realmUnitId String                     @db.Uuid
  unitId      String                     @db.Uuid
  state       ContentModerationStateKind @default(VISIBLE)
  createdAt   DateTime                   @default(now())

  /// Community/feed membership for a target Unit in a realm.
  /// This junction is not semantic tagging and is not a prerequisite or owner relation for RealmTagApplication.
  realm Unit @relation("RealmContent", fields: [realmUnitId], references: [id], onDelete: Cascade)
  unit  Unit @relation("UnitInRealm", fields: [unitId], references: [id], onDelete: Cascade)

  @@id([realmUnitId, unitId])
  @@index([unitId])
  @@index([realmUnitId, createdAt])
  @@index([realmUnitId, state, createdAt])
}

model RealmTagApplication {
  realmUnitId String  @db.Uuid
  tagUnitId   String  @db.Uuid
  unitId      String  @db.Uuid
  score       Int     @default(0)
  voteCount   Int     @default(0)
  pinned      Boolean @default(false)
  position    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A realm-scoped application of an existing global TAG Unit to any target Unit.
  /// This does not create a realm-scoped tag and does not require the target to be posted into the realm via UnitRealm.
  realm      Realm                     @relation("RealmTagApplicationRealm", fields: [realmUnitId], references: [unitId], onDelete: Cascade)
  appliedTag Unit                      @relation("RealmTagApplicationAppliedTag", fields: [tagUnitId], references: [id], onDelete: Cascade)
  targetUnit Unit                      @relation("RealmTagApplicationTargetUnit", fields: [unitId], references: [id], onDelete: Cascade)
  votes      RealmTagApplicationVote[] @relation("RealmTagApplicationVotes")

  @@id([realmUnitId, tagUnitId, unitId])
  @@index([realmUnitId, unitId])
  @@index([unitId, realmUnitId])
  @@index([tagUnitId, realmUnitId])
  @@index([realmUnitId, unitId, pinned, position])
  @@index([score])
}

model RealmTagApplicationVote {
  realmUnitId String @db.Uuid
  tagUnitId   String @db.Uuid
  unitId      String @db.Uuid
  userId      String @db.Uuid
  value       Int

  createdAt DateTime @default(now())

  /// A member vote on one RealmTagApplication.
  /// RealmTagApplicationVote's business target is the `(realmUnitId, tagUnitId, unitId)` application, not three independent Unit roles.
  application RealmTagApplication @relation("RealmTagApplicationVotes", fields: [realmUnitId, tagUnitId, unitId], references: [realmUnitId, tagUnitId, unitId], onDelete: Cascade)

  @@id([realmUnitId, tagUnitId, unitId, userId])
  @@index([userId])
}

model RealmTagContext {
  realmUnitId   String  @db.Uuid
  tagUnitId     String  @db.Uuid
  contextUnitId String? @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Pair-level explanatory surface for `(realmUnitId, tagUnitId)`.
  /// The pair is the identity; `contextUnitId` is only a materialized content carrier for explanation, examples, discussion, and history.
  realm       Realm @relation(fields: [realmUnitId], references: [unitId], onDelete: Cascade)
  tag         Unit  @relation("RealmTagContextTag", fields: [tagUnitId], references: [id], onDelete: Cascade)
  contextUnit Unit? @relation("RealmTagContextContent", fields: [contextUnitId], references: [id], onDelete: SetNull)

  @@id([realmUnitId, tagUnitId])
  @@index([tagUnitId])
}

/**
 * ANCHOR TAG SCORING SYSTEM
 */

model UnitTag {
  unitId    String @db.Uuid
  tagUnitId String @db.Uuid

  score     Int     @default(0)
  voteCount Int     @default(0)
  pinned    Boolean @default(false)
  position  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit Unit @relation("TaggedUnit", fields: [unitId], references: [id], onDelete: Cascade)
  tag  Unit @relation("UnitTagAppliedTag", fields: [tagUnitId], references: [id], onDelete: Cascade)

  @@id([unitId, tagUnitId])
  @@index([unitId, score])
  @@index([tagUnitId, score])
  @@index([unitId, pinned, position])
}

model TagVote {
  userId    String @db.Uuid
  unitId    String @db.Uuid
  tagUnitId String @db.Uuid
  value     Int

  createdAt DateTime @default(now())

  unit Unit @relation("TagVoteUnit", fields: [unitId], references: [id], onDelete: Cascade)
  tag  Unit @relation("TagVoteTag", fields: [tagUnitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId, tagUnitId])
  @@index([unitId, tagUnitId])
}

/**
 * ANCHOR POLL VOTING
 *
 * Third instance of the "scored junction + per-user vote row" pattern
 * (`UnitTag`+`TagVote`, `RealmTagApplication`+`RealmTagApplicationVote`). Only
 * the act of polling is a `Unit(type=POLL)`; options and votes are plain rows.
 * Single-choice exclusivity is enforced at the database layer (see PollVote).
 */

enum PollVoteMode {
  SINGLE
  MULTI
}

enum PollResultVisibility {
  LIVE
  AFTER_CLOSE
}

/// Poll-level configuration; a 1:1 type extension on `Unit(type=POLL)`.
model Poll {
  unitId           String               @id @db.Uuid
  voteMode         PollVoteMode         @default(SINGLE)
  resultVisibility PollResultVisibility @default(LIVE)
  /// Anonymity is a read-path/presentation guarantee, NOT reduced storage:
  /// `PollVote` still records `userId`. When true, no read path may expose the
  /// `userId`↔`optionId` mapping — only aggregate tallies + the caller's own
  /// `myVote`.
  anonymous        Boolean              @default(false)
  /// When the poll stops accepting votes and (for AFTER_CLOSE) reveals tallies.
  /// Null means open indefinitely until explicitly closed.
  closesAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit    Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  options PollOption[] @relation("PollOptions")
  votes   PollVote[]   @relation("PollVotes")
}

/// One poll option. Dual-form: exactly one of `label` (ad-hoc text) or `unitId`
/// (reference to an existing Unit) is set. NOT a Unit. `voteCount` is the
/// denormalized tally, maintained on every cast/change/withdraw.
model PollOption {
  pollUnitId String  @db.Uuid
  optionId   String  @default(dbgenerated("uuidv7()")) @db.Uuid
  position   String  @db.VarChar(64) // Fractional Indexing
  voteCount  Int     @default(0)
  label      String?
  unitId     String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poll           Poll       @relation("PollOptions", fields: [pollUnitId], references: [unitId], onDelete: Cascade)
  referencedUnit Unit?      @relation("PollOptionUnit", fields: [unitId], references: [id], onDelete: SetNull)
  votes          PollVote[] @relation("PollOptionVotes")

  @@id([pollUnitId, optionId])
  @@index([pollUnitId, position])
  @@index([unitId])
}

/// A per-user vote. Always stores `userId` (even for anonymous polls) to
/// guarantee one-vote-per-user and allow vote changes. The PK
/// `(pollUnitId, userId, optionId)` supports MULTI polls (one row per option);
/// SINGLE polls are constrained to one row per `(pollUnitId, userId)` by a
/// partial unique index (added in the migration — Prisma cannot express it).
/// `voteMode` is denormalized from `Poll.voteMode` so that partial index can
/// gate on it.
model PollVote {
  pollUnitId String       @db.Uuid
  userId     String       @db.Uuid
  optionId   String       @db.Uuid
  voteMode   PollVoteMode

  createdAt DateTime @default(now())

  poll   Poll       @relation("PollVotes", fields: [pollUnitId], references: [unitId], onDelete: Cascade)
  option PollOption @relation("PollOptionVotes", fields: [pollUnitId, optionId], references: [pollUnitId, optionId], onDelete: Cascade)

  @@id([pollUnitId, userId, optionId])
  @@index([pollUnitId, optionId])
  @@index([userId])
}

/**
 * ANCHOR ATTRIBUTION
 */

model Entity {
  unitId               String   @id @db.Uuid
  kind                 String?  @db.VarChar(32)
  avatar               String?
  verified             Boolean  @default(false)
  eligibleCreditRoles  String[] @default([])
  eligibleSubjectRoles String[] @default([])

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  sourceSite SourceSite?
}

model SourceSite {
  entityUnitId      String  @id @db.Uuid
  key               String  @unique @db.VarChar(64)
  crawlSupport      String  @db.VarChar(32)
  crawlEnabled      Boolean @default(false)
  crawlerAdapterKey String? @db.VarChar(64)
  refRules          Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity       Entity            @relation(fields: [entityUnitId], references: [unitId], onDelete: Cascade)
  externalRefs UnitExternalRef[]

  @@index([crawlSupport, crawlEnabled])
}

model UnitExternalRef {
  id                     String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  unitId                 String   @db.Uuid
  sourceSiteEntityUnitId String   @db.Uuid
  externalKind           String   @db.VarChar(64)
  externalId             String
  canonicalUrl           String
  originalUrl            String?
  firstSeenAt            DateTime @default(now())
  lastSeenAt             DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit                   Unit                        @relation("UnitExternalRefUnit", fields: [unitId], references: [id], onDelete: Cascade)
  sourceSite             SourceSite                  @relation(fields: [sourceSiteEntityUnitId], references: [entityUnitId], onDelete: Cascade)
  evidence               CreditAttributionEvidence[]
  gameSystemRequirements GameSystemRequirement[]    @relation("GameSystemRequirementSourceRef")

  @@unique([sourceSiteEntityUnitId, externalKind, externalId])
  @@index([unitId, sourceSiteEntityUnitId, externalKind])
  @@index([sourceSiteEntityUnitId, externalKind])
}

model Zone {
  unitId String @id @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  filters  Json
  template String @db.VarChar(64)
  styling  Json?
  wiki     Json?

  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditAttribution {
  unitId    String @db.Uuid
  entityId  String @db.Uuid
  role      String @db.VarChar(64)
  sortOrder Int    @default(0)

  unit     Unit                        @relation("CreditAttributedUnit", fields: [unitId], references: [id], onDelete: Cascade)
  entity   Unit                        @relation("CreditAttributionEntity", fields: [entityId], references: [id], onDelete: Cascade)
  evidence CreditAttributionEvidence[]

  @@id([unitId, entityId, role])
  @@index([entityId, role])
  @@index([unitId, role, sortOrder])
}

model CreditAttributionEvidence {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  unitId      String   @db.Uuid
  entityId    String   @db.Uuid
  role        String   @db.VarChar(64)
  sourceRefId String   @db.Uuid
  claimPath   String?
  observedUrl String?
  observedAt  DateTime @default(now())
  confidence  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditAttribution CreditAttribution @relation(fields: [unitId, entityId, role], references: [unitId, entityId, role], onDelete: Cascade)
  sourceRef         UnitExternalRef   @relation(fields: [sourceRefId], references: [id], onDelete: Cascade)

  @@index([unitId, entityId, role])
  @@index([sourceRefId])
}

model SubjectAttribution {
  unitId    String @db.Uuid
  entityId  String @db.Uuid
  role      String @db.VarChar(64)
  sortOrder Int    @default(0)
  weight    Float?

  unit   Unit @relation("SubjectAttributedUnit", fields: [unitId], references: [id], onDelete: Cascade)
  entity Unit @relation("SubjectAttributionEntity", fields: [entityId], references: [id], onDelete: Cascade)

  @@id([unitId, entityId, role])
  @@index([entityId, role, sortOrder])
  @@index([entityId, sortOrder])
  @@index([unitId, role, sortOrder])
}

/**
 * ANCHOR USER
 * UserType removed.
 */

enum EmailVerificationContractStatus {
  PENDING
  VERIFIED
  EXPIRED
}

model User {
  /// Canonical user identifier. Equals `Unit.id` for the matching USER Unit.
  unitId          String    @id @db.Uuid
  authUserId      String?   @unique @db.Uuid
  /// Main-owned Rezics product email. It may be initialized from a verified
  /// auth login email during materialization, but is not synchronized with
  /// auth.User.email after that point.
  email           String?   @db.VarChar(320)
  name            String?
  avatar          String?
  bio             String?
  /// Rich ContentDoc JSON. Search projections such as descriptionText are
  /// Meilisearch-only and must not be added as PostgreSQL columns.
  description     Json?
  joinDate        DateTime?
  permission      Json?
  followersCount  Int       @default(0)
  followingsCount Int       @default(0)
  settings        Json?
  extra           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units     Unit[]     @relation("UnitForUser")
  apiTokens ApiToken[]

  workLinkClaimsAsClaimer         WorkLinkClaim[]            @relation("WorkLinkClaimClaimer")
  workLinkClaimsAsResolver        WorkLinkClaim[]            @relation("WorkLinkClaimResolver")
  unitProgress                    UserUnitProgress[]
  contentNodeProgress             UserContentNodeProgress[]
  unitCollaborations              UnitCollaborator[]         @relation("UnitCollaboratorUser")
  unitCollaboratorsAdded          UnitCollaborator[]         @relation("UnitCollaboratorAddedBy")
  unitFieldLocksCreated           UnitFieldLock[]            @relation("UnitFieldLockLockedBy")
  historyOutboxAuthored           HistoryOutbox[]            @relation("HistoryOutboxActor")
  historyOutboxProcessed          HistoryOutbox[]            @relation("HistoryOutboxProcessor")
  unitAliasesCreated              UnitAlias[]                @relation("UnitAliasCreatedBy")
  unitAliasesUpdated              UnitAlias[]                @relation("UnitAliasUpdatedBy")
  unitAliasVotes                  UnitAliasVote[]            @relation("UnitAliasVoteUser")
  adminWorkMergesCreated          AdminWorkMergeOperation[]  @relation("AdminWorkMergeActor")
  adminWorkMergesReverted         AdminWorkMergeOperation[]  @relation("AdminWorkMergeRevertedBy")
  staffGrantsReceived             StaffGrant[]               @relation("StaffGrantUser")
  staffGrantsCreated              StaffGrant[]               @relation("StaffGrantGrantedBy")
  staffGrantsRevoked              StaffGrant[]               @relation("StaffGrantRevokedBy")
  realmGrantsCreated              RealmCapabilityGrant[]     @relation("RealmCapabilityGrantGrantedBy")
  realmGrantsRevoked              RealmCapabilityGrant[]     @relation("RealmCapabilityGrantRevokedBy")
  accountEnforcements             AccountEnforcement[]       @relation("AccountEnforcementTarget")
  accountEnforcementsDecided      AccountEnforcement[]       @relation("AccountEnforcementDecidedBy")
  accountEnforcementsRevoked      AccountEnforcement[]       @relation("AccountEnforcementRevokedBy")
  moderationCasesReported         ModerationCase[]           @relation("ModerationCaseReporter")
  moderationCasesSubject          ModerationCase[]           @relation("ModerationCaseSubject")
  moderationCasesAssigned         ModerationCase[]           @relation("ModerationCaseAssignedTo")
  moderationCaseEvents            ModerationCaseEvent[]      @relation("ModerationCaseEventActor")
  realmQueueReports               RealmModerationQueueItem[] @relation("RealmModerationQueueReporter")
  realmQueueSubjects              RealmModerationQueueItem[] @relation("RealmModerationQueueSubject")
  realmQueueAssignments           RealmModerationQueueItem[] @relation("RealmModerationQueueAssignedTo")
  realmModerationEvents           RealmModerationEvent[]     @relation("RealmModerationEventActor")
  contentModerationDecisions      ContentModerationState[]   @relation("ContentModerationStateDecidedBy")
  realmContentModerationDecisions RealmContentModeration[]   @relation("RealmContentModerationDecidedBy")
  realmRuleAcknowledgements       RealmRuleAcknowledgement[]
  staffAuditLogs                  StaffAuditLog[]            @relation("StaffAuditLogActor")

  @@index([email])
}

/// User-to-user block. Directional: `blockerId` blocked `blockedId`. Mutual
/// blocking is two rows. Hides the blocked user's content from the blocker's
/// feeds and prevents direct messages in either direction. References are
/// id-only (no FK relation) to match the `Feedback` convention; account
/// deletion removes the user's rows explicitly.
model UserBlock {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UnitCollaborator {
  unitId    String   @db.Uuid
  userId    String   @db.Uuid
  roleKey   String   @db.VarChar(32)
  addedById String   @db.Uuid
  createdAt DateTime @default(now())

  unit    Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user    User @relation("UnitCollaboratorUser", fields: [userId], references: [unitId], onDelete: Cascade)
  addedBy User @relation("UnitCollaboratorAddedBy", fields: [addedById], references: [unitId], onDelete: Restrict)

  @@id([unitId, userId])
  @@index([userId, roleKey])
  @@index([unitId, roleKey])
}

model UnitFieldLock {
  unitId     String   @db.Uuid
  path       String   @db.VarChar(256)
  lockedById String   @db.Uuid
  reason     String?
  createdAt  DateTime @default(now())

  unit     Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lockedBy User @relation("UnitFieldLockLockedBy", fields: [lockedById], references: [unitId], onDelete: Restrict)

  @@id([unitId, path])
  @@index([lockedById, createdAt])
}

/// Per-Unit canonical history sequence allocator. This clock advances only for
/// authorized commits applied to canonical state, not editor autosave, drafts,
/// picker selections, drag gestures, or uncommitted frontend op logs.
model UnitHistoryClock {
  unitId       String   @id @db.Uuid
  nextSequence BigInt   @default(1)
  updatedAt    DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

/// Durable queue for canonical history commits emitted by main database
/// mutations. Rows represent semantic editorial, structure, lock, or
/// collaborator commits and must not be used for autosave, draft persistence, or
/// per-click editor operation logs.
model HistoryOutbox {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  unitId        String    @db.Uuid
  sequence      BigInt
  actorUserId   String    @db.Uuid
  category      String    @db.VarChar(64)
  payload       Json
  payloadHash   String?   @db.VarChar(64)
  status        String    @default("pending") @db.VarChar(32)
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  processedAt   DateTime?
  processedById String?   @db.Uuid
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  unit        Unit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  actor       User  @relation("HistoryOutboxActor", fields: [actorUserId], references: [unitId], onDelete: Restrict)
  processedBy User? @relation("HistoryOutboxProcessor", fields: [processedById], references: [unitId], onDelete: SetNull)

  @@unique([unitId, sequence])
  @@index([status, nextAttemptAt, createdAt])
  @@index([unitId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([processedById])
}

model EmailVerificationContract {
  id             String                          @id @default(uuid()) @db.Uuid
  contractName   String                          @db.VarChar(96)
  ownerId        String                          @db.Uuid
  email          String                          @db.VarChar(320)
  status         EmailVerificationContractStatus @default(PENDING)
  codeHash       String?
  deliveryStatus String?                         @db.VarChar(64)
  source         String?                         @db.VarChar(64)
  verifiedAt     DateTime?
  expiresAt      DateTime?
  lastSentAt     DateTime?
  attempts       Int                             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractName, ownerId, email])
  @@index([contractName, ownerId, status])
  @@index([email])
}

