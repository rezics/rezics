  userId String @db.Uuid
  unitId String @db.Uuid
  realm  String @db.Uuid
  value  Int
  fields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linkedPosts Post[] @relation("PostScoreEntry")

  @@unique([userId, unitId, realm])
  @@index([unitId, realm])
  @@index([userId, unitId])
}

model ScoreAggregate {
  unitId       String @db.Uuid
  realm        String @db.Uuid
  totalScore   Int    @default(0)
  totalCount   Int    @default(0)
  distribution Json
  fields       Json?

  updatedAt DateTime @updatedAt

  @@id([unitId, realm])
}

model ScoreRealmField {
  realm     String  @db.Uuid
  key       String  @db.VarChar(64)
  label     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([realm, key])
  @@index([realm, sortOrder])
}

/// Generic attention edge from a subscriber Unit (USER in v1) to any
/// target Unit. `channels` is a String[] filter using dot-namespaced
/// events with three wildcard tiers (`'*'`, `'<category>.*'`,
/// `'<category>.<event>'`); see `@rezics/contract` `CHANNEL_REGISTRY`
/// for the per-target-type registry. The fan-out resolver in
/// `notify-boundary` performs three GIN-indexable array-containment
/// checks against `channels`. The GIN index is added via raw SQL in
/// the migration since Prisma does not yet model GIN.
model Subscription {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subscriberUnitId String   @db.Uuid
  targetUnitId     String   @db.Uuid
  channels         String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriber Unit @relation("SubscriptionSubscriber", fields: [subscriberUnitId], references: [id], onDelete: Cascade)
  target     Unit @relation("SubscriptionTarget", fields: [targetUnitId], references: [id], onDelete: Cascade)

  @@unique([subscriberUnitId, targetUnitId])
  @@index([targetUnitId])
  @@index([subscriberUnitId])
  @@index([channels], type: Gin, map: "subscription_channels_gin")
}

model ApiToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @db.Uuid
  name       String
  tokenHash  String    @unique
  scopes     Json      @default("{}")
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?
  lastIP     String?
  userAgent  String?
  revoked    Boolean   @default(false)
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [unitId], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

