  targetId         String                    @db.VarChar(128)
  targetUnitId     String?                   @db.Uuid
  sourceFeedbackId String?                   @db.Uuid
  linkedCaseId     String?                   @db.Uuid
  assignedToUserId String?                   @db.Uuid
  reason           String?
  safeSummary      String?
  metadata         Json?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  targetRealm    Realm                  @relation(fields: [realmUnitId], references: [unitId], onDelete: Cascade)
  reporter       User?                  @relation("RealmModerationQueueReporter", fields: [reporterUserId], references: [unitId], onDelete: SetNull)
  subject        User?                  @relation("RealmModerationQueueSubject", fields: [subjectUserId], references: [unitId], onDelete: SetNull)
  targetUnit     Unit?                  @relation("RealmModerationQueueTargetUnit", fields: [targetUnitId], references: [id], onDelete: SetNull)
