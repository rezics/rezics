model UserUnitProgress {
  userId         String                 @db.Uuid
  unitId         String                 @db.Uuid
  progress       Float                  @default(0)
  status         UserUnitProgressStatus @default(BACKLOG)
  isDeleted      Boolean                @default(false)
  completedCount Int                    @default(0)
  totalTimeMs    BigInt                 @default(0)
  lastPosition   Json?
  extra          Json?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [unitId], onDelete: Cascade)
  unit Unit @relation("ProgressUnit", fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@index([userId, lastSeenAt(sort: Desc)])
  @@index([unitId, status])
  @@index([userId, isDeleted, lastSeenAt(sort: Desc)])
}

