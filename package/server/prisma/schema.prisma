model ModerationCase {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  state             ModerationCaseState @default(NEW)
  severity          String?             @db.VarChar(32)
  reporterUserId    String?             @db.Uuid
  subjectUserId     String?             @db.Uuid
  targetKind        String              @db.VarChar(64)
  targetId          String              @db.VarChar(128)
  targetUnitId      String?             @db.Uuid
  realmUnitId       String?             @db.Uuid
  sourceFeedbackId  String?             @db.Uuid
  assignedToUserId  String?             @db.Uuid
  duplicateOfCaseId String?             @db.Uuid
  reason            String?
  safeSummary       String?
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  reporter       User?            @relation("ModerationCaseReporter", fields: [reporterUserId], references: [unitId], onDelete: SetNull)
  subject        User?            @relation("ModerationCaseSubject", fields: [subjectUserId], references: [unitId], onDelete: SetNull)
  targetUnit     Unit?            @relation("ModerationCaseTargetUnit", fields: [targetUnitId], references: [id], onDelete: SetNull)
  realm          Unit?            @relation("ModerationCaseRealm", fields: [realmUnitId], references: [id], onDelete: SetNull)
  sourceFeedback Feedback?        @relation("ModerationCaseSourceFeedback", fields: [sourceFeedbackId], references: [id], onDelete: SetNull)
  assignedTo     User?            @relation("ModerationCaseAssignedTo", fields: [assignedToUserId], references: [unitId], onDelete: SetNull)
  duplicateOf    ModerationCase?  @relation("ModerationCaseDuplicates", fields: [duplicateOfCaseId], references: [id], onDelete: SetNull)
  duplicates     ModerationCase[] @relation("ModerationCaseDuplicates")

  events                 ModerationCaseEvent[]
  realmQueueItems        RealmModerationQueueItem[]
  contentStates          ContentModerationState[]
  realmContentModeration RealmContentModeration[]

  @@index([state, severity, createdAt])
  @@index([realmUnitId, state, createdAt])
  @@index([assignedToUserId, state, createdAt])
  @@index([targetKind, targetId])
  @@index([targetUnitId, state])
  @@index([subjectUserId, state, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([sourceFeedbackId])
  @@index([duplicateOfCaseId])
}

