---
import * as Viz from "@viz-js/viz";
import { REZICS_ARCHITECTURE_DOT } from "./rezicsArchitectureGraph";

const viz = await Viz.instance();
const architectureSvg = viz
  .renderString(REZICS_ARCHITECTURE_DOT, {
    format: "svg",
    engine: "dot",
  })
  .replace(/^<\?xml[^>]*>\s*/, "")
  .replace(/^<!DOCTYPE svg[\s\S]*?>\s*/, "");
---

<figure
  class="architecture-graph"
  aria-labelledby="architecture-graph-title"
  aria-describedby="architecture-graph-description"
>
  <figcaption>
    <span id="architecture-graph-title">One work, many community surfaces</span>
    <span id="architecture-graph-description">
      Rezics keeps catalog records, reviews, shelves, wiki knowledge, and realm
      classification anchored to the same Work Unit.
    </span>
  </figcaption>
  <div class="architecture-graph-svg" set:html={architectureSvg} />
</figure>
