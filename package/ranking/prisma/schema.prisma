generator client {
  provider      = "prisma-client"
  output        = "./generated"
  moduleFormat  = "esm"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgres"
}

enum RankingScopeKind {
  global
  realm
  work
  tag
  parent
}

enum RankingRankKind {
  content
  post
  comment
}

enum RankingSignalKind {
  view
  read
}

enum RankingPatchStatus {
  pending
  patched
  failed
  skipped
}

model UnitRankProjection {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId         String             @db.Uuid
  scopeKind      RankingScopeKind
  scopeId        String?            @db.Uuid
  scopeKey       String             @db.VarChar(64)
  rankKind       RankingRankKind
  hotScore       Float              @default(0)
  topScore       Float              @default(0)
  trendingScore  Float              @default(0)
  qualityScore   Float              @default(0)
  formulaVersion String
  signalSnapshot Json
  computedAt     DateTime           @default(now())
  rankUpdatedAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  patches        ServingPatchStatus[]

  @@unique([unitId, scopeKind, scopeKey, rankKind])
  @@index([unitId])
  @@index([scopeKind, scopeId, rankKind])
  @@index([rankKind, hotScore])
  @@index([rankKind, trendingScore])
}

model RankingSignalBucket {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId      String            @db.Uuid
  signalKind  RankingSignalKind
  bucketStart DateTime
  bucketEnd   DateTime
  count       Int               @default(0)
  metadata    Json?
  flushedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([unitId, signalKind, bucketStart])
  @@index([signalKind, bucketStart])
  @@index([unitId, flushedAt])
}

model RankingFormulaVersion {
  version     String   @id
  rankKinds   String[]
  description String?
  config      Json
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ServingPatchStatus {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectionId  String              @db.Uuid
  unitId        String              @db.Uuid
  indexName     String              @db.VarChar(64)
  documentId    String              @db.Uuid
  status        RankingPatchStatus  @default(pending)
  patchedAt     DateTime?
  lastAttemptAt DateTime?
  retryCount    Int                 @default(0)
  lastError     String?
  source        Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  projection    UnitRankProjection  @relation(fields: [projectionId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([indexName, documentId])
  @@index([status, lastAttemptAt])
}
