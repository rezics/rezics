{
  "name": "@rezics/ranking",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch --no-cache src/index.ts",
    "build": "bun build src/cluster.ts --compile --minify-whitespace --minify-syntax --target bun --outfile ranking",
    "build:linux": "bun build src/cluster.ts --compile --minify-whitespace --minify-syntax --target bun-linux-x64 --outfile ranking",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:deploy": "bunx prisma migrate deploy && bun run prisma:generate",
    "prisma:studio": "bunx prisma studio"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.8.0"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "^1.4.14",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@rezics/job": "workspace:*",
    "@rezics/search": "workspace:*",
    "@rezics/server": "workspace:*",
    "@rezics/shared": "workspace:*",
    "@t3-oss/env-core": "^0.13.10",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.22",
    "pg": "^8.16.3",
    "valibot": "^1.2.0"
  }
}
