{
    "name": "database",
    "version": "0.0.1",
    "type": "module",
    "packageManager": "pnpm@10.13.1",
    "scripts": {
        "generate": "pnpx @gel/generate queries --target ts --file ./query && pnpx @gel/generate interfaces --file ./interface.ts"
    },
    "exports": {
        ".": {
            "default": "./index.ts"
        },
        "./interface": {
            "default": "./interface.ts"
        },
        "./query": {
            "default": "./query.ts"
        }
    }
}
