select User {
    id,
    name,
    email,
    description,
    created_at,
    updated_at,
    friends: {
        id,
        name
    },
    owned_tags: {
        id,
        name,
        type
    },
    owned_favorites: {
        id
    }
}
filter (
    (.id = <optional uuid>$id) ??
    (.name = <optional str>$name) ??
    (.email = <optional str>$email)
)
