select Identification {
    id,
    password_valid := ext::pgcrypto::crypt(<str>$password, .password_hash) = .password_hash,
    user: {
        id,
        name,
        email,
        description,
        created_at,
        updated_at
    }
}
filter (
    (.user.email = <str>$email) or
    (.user.name = <str>$username)
)
