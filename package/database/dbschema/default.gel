using extension auth;
using extension ai;

module default {
    scalar type short_str extending str {
        constraint max_len_value(100);
    }

    scalar type medium_str extending str {
        constraint max_len_value(1000);
    }

    scalar type long_str extending str {
        constraint max_len_value(10000);
    }

    abstract type Auditable {
        required created_at: datetime {
            rewrite insert using (datetime_of_statement());
            readonly := true;
        }
        required updated_at: datetime {
            rewrite insert, update using (datetime_of_statement())
        }
    }

    abstract type Tagable {
        multi link tags: Nameable;
    }

    abstract type Nameable {
        required name: medium_str;

        index on (.name);
    }

    abstract type Evaluable {
        multi link up: Person;
        multi link down: Person;
        multi link favorites: Person;
    }

    type Book extending Nameable, Auditable, Evaluable, Tagable {
        cover: str;
        released_at: datetime;
        real_updated_at: datetime;

        required grabbed_from: str;
        description: long_str;
        required length: bigint;

        required multi link author: Author;
        multi link units: Unit {
            constraint exclusive;
        }
        multi link publishers: Publisher {
            required date: datetime;
            required isbn: short_str;
        }

        index on ((.length, .released_at, .real_updated_at));
    }

    type Unit extending Nameable, Evaluable, Tagable {
        required order: int32;
        multi link children: Unit {
            constraint exclusive;
        }
        link parent := .<children[is Unit];
        link book :=  .<units[is Book];

        index on (.order);
    }

    type CustomTag extending Nameable {
        required single link owner: Person;
    }

    type Publisher extending Nameable, Evaluable, Tagable {
        required domain: short_str;
        multi link books := .<publishers[is Book];

        index on (.domain);
    }

    type Author extending Nameable, Evaluable, Tagable {
        description: long_str;
        single link user: Person;
        multi link books := .<author[is Book];
    }

    abstract type Person extending Nameable, Auditable, Evaluable, Tagable {
        owned_favorites := .<favorites[is Evaluable];
        owned_tags := .<owner[is Nameable];
    }

    type User extending Person {
        required email: short_str;
        description: long_str;
        multi link friends: User;

        required identity: ext::auth::Identity {
            constraint exclusive;
        };

        index on (.email);
    }

    type Organization extending Person {
        multi link members: Person {
            power: int32 {
                default := 99;
                constraint min_value(0);
                constraint max_value(99);
            }
        }
    }

    type Thread extending Nameable, Auditable, Evaluable, Tagable {
        required link author: Person;
        required content: long_str;

        multi link replies: Thread;
    }
}
