generator client {
  provider      = "prisma-client"
  output        = "./generated"
  moduleFormat  = "esm"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgres"
}

model User {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug          String    @unique
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@index([email])
  @@index([slug])
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  alg        String?
  crv        String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@index([createdAt])
  @@index([expiresAt])
}

model OAuthClient {
  id                      String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clientId                String   @unique
  clientSecret            String?
  disabled                Boolean  @default(false)
  skipConsent             Boolean?
  enableEndSession        Boolean?
  scopes                  String[]
  userId                  String?  @db.Uuid
  referenceId             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[]
  tos                     String?
  policy                  String?
  softwareId              String?
  softwareVersion         String?
  softwareStatement       String?
  redirectUris            String[]
  postLogoutRedirectUris  String[]
  tokenEndpointAuthMethod String?
  grantTypes              String[]
  responseTypes           String[]
  public                  Boolean?
  type                    String?
  requirePKCE             Boolean?
  metadata                Json?

  @@index([userId])
  @@index([referenceId])
}

model OAuthRefreshToken {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token       String
  clientId    String
  sessionId   String?
  userId      String
  referenceId String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revoked     DateTime?
  authTime    DateTime?
  scopes      String[]

  @@unique([token])
  @@index([clientId])
  @@index([userId])
  @@index([sessionId])
}

model OAuthAccessToken {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token       String   @unique
  clientId    String
  sessionId   String?
  userId      String?
  referenceId String?
  refreshId   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  scopes      String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
}

model OAuthConsent {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clientId    String
  userId      String?
  referenceId String?
  scopes      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
  @@index([referenceId])
}
