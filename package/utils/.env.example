# Required by the seed CLI (`task seed`, `task factory`).
#
# These are normally populated automatically from each package's local .env:
#   - package/auth/.env   → DATABASE_URL → AUTH_DATABASE_URL
#   - package/server/.env → DATABASE_URL → SERVER_DATABASE_URL
#   - package/server/.env → MEILI_HOST / MEILI_MASTER_KEY
#
# Set them explicitly below ONLY if you want to override that auto-load
# (e.g. seed against a different database/search instance than the running services use).

AUTH_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_auth?schema=public"
SERVER_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_server?schema=public"
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=masterKey
