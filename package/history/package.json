{
  "name": "@rezics/history",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./outbox": {
      "types": "./src/outbox/index.ts",
      "default": "./src/outbox/index.ts"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "default": "./src/db/index.ts"
    },
    "./db/schema": {
      "types": "./src/db/schema/index.ts",
      "default": "./src/db/schema/index.ts"
    },
    "./revision/*": {
      "types": "./src/revision/*.ts",
      "default": "./src/revision/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch --no-cache src/index.ts",
    "build": "bun build src/cluster.ts --compile --minify-whitespace --minify-syntax --target bun --outfile history",
    "build:linux": "bun build src/cluster.ts --compile --minify-whitespace --minify-syntax --target bun-linux-x64 --outfile history",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "1.0.0-rc.3"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "^1.4.14",
    "@rezics/contract": "workspace:*",
    "@rezics/server": "workspace:*",
    "@rezics/shared": "workspace:*",
    "@t3-oss/env-core": "^0.13.8",
    "dotenv": "^17.2.3",
    "drizzle-orm": "1.0.0-rc.3",
    "elysia": "^1.4.22",
    "pg": "^8.16.3",
    "valibot": "^1.2.0"
  }
}
