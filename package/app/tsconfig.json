{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "allowJs": true,
        "checkJs": true,
        "baseUrl": ".",
        "noImplicitAny": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "paths": {
            "@/*": ["src/*"]
        },
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "skipLibCheck": true
    },
    "include": ["node_modules/vite/client.d.ts", "**/*"],
    "extends": ["@tsconfig/strictest/tsconfig.json"]
}
