{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",

    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,

    "paths": {
      "@/*": ["./src/*"],
      "@component/*": ["./src/component/*"],
      "@page/*": ["./src/page/*"],
      "@locale": ["./src/locale/index.ts"],
      "@app/*": ["./src/app/*"]
    },

    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "node_modules"]
}
