{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "allowJs": true,
        "checkJs": true,

        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "skipLibCheck": true,

        "paths": {
            "@/*": ["./src/*"],
            "@page/*": ["./src/page/*"],
            "@component/*": ["./src/component/*"],
            "@util/*": ["./src/util/*"]
        }
    },
    "include": ["node_modules/vite/client.d.ts", "**/*"],
    "extends": ["@tsconfig/strictest/tsconfig.json"]
}
