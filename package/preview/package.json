{
  "name": "@rezics/preview",
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "module": "src/index.ts",
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch src/index.ts",
