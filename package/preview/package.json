    "@elysiajs/html": "^1.4.2",
    "@elysiajs/openapi": "^1.4.14",
    "@kitajs/html": "^4.2.13",
    "@rezics/server": "workspace:*",
    "@rezics/contract": "workspace:*",
    "@rezics/shared": "workspace:*",
    "@rezics/ui": "workspace:*",
    "@faker-js/faker": "^10.1.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.22",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "@types/pg": "^8.15.5"
  }
}
