generator client {
  provider      = "prisma-client"
  output        = "./generated"
  moduleFormat  = "esm"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgres"
  url      = env("PRISMA_DATABASE_URL")
}

/**
 * =========================
 * Enums
 * =========================
 */

enum UnitType {
  BOOK
  COMMENT
  NOTE
  REMARK // 区分用户书评和鉴赏家书评（REVIEW）
  REVIEW
  DOMAIN
  TAG
  QUOTE
  READLIST
  IMAGE
  VIDEO
  CHAPTER
}

enum UnitStatus {
  DRAFT
  ACTIVE
  DELETED
  FROZEN
}

enum UserType {
  USER
  AUTHOR
  PRESS
  PRODUCER
}

/**
 * ANCHOR User
 * TODO 增加子组织
 * also use unitId
 */
model User {
  unitId       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String @unique
  slug         String @unique
  passwordHash String

  type UserType @default(USER)

  name        String
  avatar      String?
  bio         String?
  description String? // Descriptive wiki for authors/publishers
  joinDate    DateTime?

  permission Json?

  followersCount  Int @default(0) // 粉丝数
  followingsCount Int @default(0) // 关注数

  followers  Follow[] @relation("UserFollowers")
  followings Follow[] @relation("UserFollowings")

  // Relations
  Units        Unit[]     @relation("UnitForUser")
  authorBook   Book[]     @relation("BookAuthor")
  pressBook    Book[]     @relation("BookPress")
  producerBook Book[]     @relation("BookProducer")
  reactions    Reaction[] @relation("UserReactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([email])
}

model VerificationCode {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @db.Uuid
  email     String    @unique
  code      String
  expiresAt DateTime
  usedAt    DateTime? // 提供接口，暂时还不支持
  createdAt DateTime  @default(now())

  @@index([email])
}

model Follow {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  follower   User   @relation("UserFollowings", fields: [followerId], references: [unitId])
  followerId String @db.Uuid

  following   User   @relation("UserFollowers", fields: [followingId], references: [unitId])
  followingId String @db.Uuid

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
}

/**
 * ANCHOR Unit (统一内容入口)
 * - 仅固定最小公约字段；弹性入 metadata(JSON)
 * - 其它类型（REVIEW/QUOTE/READLIST…）都在这里
 */
model Unit {
  // basic info
  id             String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String @db.Uuid
  user           User   @relation("UnitForUser", fields: [userId], references: [unitId], onDelete: Cascade)
  domains        Unit[] @relation("UnitDomains")
  domainIncludes Unit[] @relation("UnitDomains")

  type   UnitType
  status UnitStatus @default(ACTIVE)

  title    String?
  content  String?
  metadata Json    @default("{}")
  nsfw     Boolean @default(false)

  // 可选：指向任意 Unit 的“弱引用”
  // 可被用于 Chapter，Review，Quote，Note，ReadList，Image，Video
  // TODO Check if targetUnitId is needed
  targetUnitId String? @db.Uuid
  targetUnit   Unit?   @relation("UnitTargets", fields: [targetUnitId], references: [id])
  targetedBy   Unit[]  @relation("UnitTargets")

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Book relation
  book Book? @relation("BookIndexForUnit")

  // ReadList relation
  readList          ReadList?  @relation("ReadListIndexForUnit")
  reviewForReadList ReadList[] @relation("ReviewForReadList")

  // Tag relation
  tag  Tag?  @relation("TagIndexForUnit")
  tags Tag[] @relation("UnitTags")

  // === CommentIndex 的 3 条反向关系 ===
  // 1) 这条评论本体对应的 Unit（1:1）
  commentIndex CommentIndex? @relation("CommentIndexForUnit")

  // 2) 作为“根对象”的 Unit（1:N）
  commentRoots CommentIndex[] @relation("RootUnit")

  // 3) 作为“父评论”的 Unit（1:N）
  childCommentIndexes CommentIndex[] @relation("ParentComment")

  reactions         Reaction[]        @relation("UnitReactions")
  reactionSummaries ReactionSummary[] @relation("UnitReactionSummaries")

  @@index([type, status, createdAt])
  @@index([userId, createdAt])
  @@index([targetUnitId])
}

/**
 * ANCHOR Book（1:1 绑定 Unit）
 * 仅 Book 拥有专表；章节树、额外域等放 JSON
 * authors 就是纯字符串，关联用户的话单独做
 */
model Book {
  // 与 Unit 1:1 绑定；采用 Unit.id 作为主键
  unitId String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  unit   Unit   @relation("BookIndexForUnit", fields: [unitId], references: [id], onDelete: Cascade)

  title        String
  author       User[]     @relation("BookAuthor") // User[]，作者列表，所有作者都会被注册为用户
  press        User[]     @relation("BookPress")
  producer     User[]     @relation("BookProducer")
  tags         String[]   @default([])
  description  String?
  coverUrl     String?
  isbn         String?
  // chaptersIndex String? // 章节树状信息, 章节信息类似Review,统一使用
  chapterIndex BookIndex?
  extra        Json? // 领域扩展（出版社、出版年、装帧…）

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  readList  ReadList[] @relation("ReadListForBook")

  @@index([title])
  @@index([isbn])
}

model BookIndex {
  bookUnitId String   @id @db.Uuid
  book       Book     @relation(fields: [bookUnitId], references: [unitId], onDelete: Cascade)
  index      Json // 目录 JSON
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/**
 * ANCHOR ReadList: 阅读列表
 */
model ReadList {
  unitId    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  unit      Unit     @relation("ReadListIndexForUnit", fields: [unitId], references: [id], onDelete: Cascade)
  review    Unit[]   @relation("ReviewForReadList")
  book      Book[]   @relation("ReadListForBook")
  order     String[] @default([]) // review unitId list
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TODO 检查下列 unitId 是否需要, 只有真正绑定 Unit 的才需要 unitId

/**
 * ANCHOR CommentIndex: 评论树“关系索引表”
 * - 每条评论本体是 Unit(type='COMMENT')
 * - 该表存 root/parent/depth，加速树查询
 */
model CommentIndex {
  // 这条“评论 Unit”的 id（与 Unit 1:1）
  unitId String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  unit   Unit   @relation("CommentIndexForUnit", fields: [unitId], references: [id], onDelete: Cascade)

  // 根对象
  rootUnitId String @db.Uuid
  rootUnit   Unit   @relation("RootUnit", fields: [rootUnitId], references: [id], onDelete: Cascade)

  // 父级评论（同为 Unit）
  parentCommentId String? @db.Uuid
  parentComment   Unit?   @relation("ParentComment", fields: [parentCommentId], references: [id], onDelete: SetNull)

  depth Int
  // 删掉多余/重复的 @@index([rootUnitId])，避免重复索引

  @@index([rootUnitId, depth])
  @@index([parentCommentId])
}

/**
 * ANCHOR UnitStats: 统计与互动
 * - 评论数等冗余计数（列表/详情快取）
 * - 赞/踩/爱心计数聚合
 */
model Reaction {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  user   User   @relation("UserReactions", fields: [userId], references: [unitId], onDelete: Cascade)
  userId String @db.Uuid

  targetId   String @db.Uuid // bookId / chapterId / commentId
  targetUnit Unit   @relation("UnitReactions", fields: [targetId], references: [id], onDelete: Cascade)

  reaction String // like, bookmark, laugh, etc.

  createdAt DateTime @default(now())

  @@unique([userId, targetId, reaction])
  @@index([targetId])
  @@index([targetId, reaction])
  @@index([userId, reaction])
}

model Bookmark {
  userId    String   @db.Uuid
  targetId  String   @db.Uuid // use userId targetId userId to query all user tags
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, targetId])
  @@index([userId])
  @@index([targetId])
}

model ReactionSummary {
  targetId   String @db.Uuid
  targetUnit Unit   @relation("UnitReactionSummaries", fields: [targetId], references: [id], onDelete: Cascade)
  reaction   String
  count      Int    @default(0)

  @@id([targetId, reaction])
  @@index([targetId])
}

model Rating {
  unitId     String   @db.Uuid
  domain     String   @db.Uuid // UnitId
  totalScore Int      @default(0)
  totalCount Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@id([unitId, domain]) // 联合主键
}

/**
 * ANCHOR Tag: 作用于任意 Unit（含 Book）
 * TODO 迁移到unitId
 */
model Tag {
  unitId String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  unit   Unit    @relation("TagIndexForUnit", fields: [unitId], references: [id], onDelete: Cascade)
  name   String
  i18n   Json?
  type   String? // e.g. general / book / author / system

  units Unit[] @relation("UnitTags")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, name, type])
  @@index([type])
}

/**
 * ANCHOR EchoKV: 临时存储
 */
model EchoKV {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * 说明与迁移提示（非运行字段）
 * - JSONB/GiN 索引：Prisma schema 不直接声明 GiN，
 * 请在迁移中加 raw SQL，如：
 * CREATE INDEX idx_Units_metadata_gin ON "Unit" USING GIN(("metadata"));
 * - 若要 ltree/物化路径，可在迁移里启用扩展并增列，或保留目前索引表实现。
 * - 典型 metadata 结构（示例）：
 * REVIEW:   { "rating": 4.5, "title": "短评标题" }
 * QUOTE:    { "text": "...", "fromChapter": 12 }
 * READLIST: { "coverUrl": "...", "books": ["<bookunitId1>", "<bookunitId2>"] }
 */
