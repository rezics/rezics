// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @unique

  ratings  Rating[]
  comments Comment[]

  @@index([id], name: "user_id_index")
  @@map("users")
}

model Book {
  id          String   @id @unique @default(cuid())
  title       String
  description String?
  cover       String?
  publishAt   DateTime

  status   BookStatus @relation(fields: [statusId], references: [id])
  statusId String

  publisher   Publisher @relation(fields: [publisherId], references: [id])
  publisherId String

  author   Author @relation(fields: [authorId], references: [id])
  authorId String

  autoTags   AutoTag[]
  manualTags ManualTag[]

  ratings  Rating[]
  comments Comment[]

  @@index([id], name: "book_id_index")
  @@index([title], name: "book_title_index")
  @@map("books")
}

model BookStatus {
  id          String   @id @unique @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]

  @@map("book_statuses")
}

model Author {
  id          String   @id @unique @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]

  @@map("authors")
}

model Publisher {
  id          String   @id @unique @default(cuid())
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]

  @@map("publishers")
}

model Rating {
  id        String   @id @unique @default(cuid())
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book   Book   @relation(fields: [bookId], references: [id])
  bookId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  @@map("ratings")
}

model Comment {
  id        String   @id @unique @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book   Book   @relation(fields: [bookId], references: [id])
  bookId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  parent Comment? @relation("CommentTree", fields: [parentId], references: [id])
  parentId String?
  subComments Comment[] @relation("CommentTree")

  @@map("comments")
}

model AutoTag {
  id          String   @id @unique @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]

  @@map("auto_tags")
}

model ManualTag {
  id          String   @id @unique @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]

  @@map("manual_tags")
}
