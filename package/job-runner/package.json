{
  "name": "@rezics/job-runner",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:ensure": "bun run scripts/ensure-job-db.ts",
    "dev": "NODE_ENV=development bun run --watch --no-cache src/index.ts",
    "build": "bun build src/index.ts --compile --minify-whitespace --minify-syntax --target bun --outfile job-runner",
    "build:linux": "bun build src/index.ts --compile --minify-whitespace --minify-syntax --target bun-linux-x64 --outfile job-runner",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "^1.4.14",
    "@rezics/history": "workspace:*",
    "@rezics/job": "workspace:*",
    "@rezics/search": "workspace:*",
    "@rezics/server": "workspace:*",
    "@rezics/shared": "workspace:*",
    "@t3-oss/env-core": "^0.13.10",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.22",
    "meilisearch": "^0.54.0",
    "pg": "^8.16.3",
    "pg-boss": "^10.3.2",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.15.5"
  },
  "peerDependencies": {
    "typescript": "^6"
  }
}
