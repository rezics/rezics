NODE_ENV=development

# ── Queue Database ───────────────────────────────────────
# Dedicated pg-boss database. Do not reuse the main server database.
JOB_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_jobs"

# ── Source Databases ─────────────────────────────────────
# Main server database used for current-state reads while executing jobs.
SERVER_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_booklib?schema=public"

# History database used by history outbox ingestion jobs.
HISTORY_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_history?schema=public"

# ── Search ────────────────────────────────────────────────
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=masterKey

# ── Internal Auth ─────────────────────────────────────────
# Must match @rezics/server JOB_RUNNER_INTERNAL_SECRET.
JOB_RUNNER_INTERNAL_SECRET=change-me-job-runner-internal-secret

# Shared secret expected on Sequin webhook delivery.
SEQUIN_WEBHOOK_SECRET=change-me-sequin-webhook-secret

# ── Sequin Runtime ───────────────────────────────────────
# Source database consumed by Sequin CDC. These examples are for local
# development only and are DO-NOT-USE-IN-PRODUCTION values.
ENV=development
SOURCE_DB_HOST=host.docker.internal
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=rezics_booklib
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=postgres

# Sequin state Postgres password for tool/external-services/sequin.
PG_PASSWORD=DO-NOT-USE-IN-PRODUCTION-sequin-state-postgres

# Exposed by `bun run service:sequin:up`.
JOB_RUNNER_BASE_URL=http://host.docker.internal:3005
SEQUIN_HEALTH_URL=http://127.0.0.1:7376/health

# Generate real values before starting Sequin:
#   openssl rand -base64 48  # SECRET_KEY_BASE
#   openssl rand -base64 32  # VAULT_KEY
SECRET_KEY_BASE=DO-NOT-USE-IN-PRODUCTION-secret-key-base
VAULT_KEY=DO-NOT-USE-IN-PRODUCTION-vault-key

# ── Service ───────────────────────────────────────────────
# all = HTTP API + workers; http = API only; worker = workers only.
JOB_RUNNER_ROLE=all
PORT=3005
