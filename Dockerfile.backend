# Backend monolith image. The runtime binary mounts the main API plus the
# former auth/notify/reaction/history/ranking/preview service apps.
#
#   docker build -f Dockerfile.base -t rezics-base:dev .
#   docker build -f Dockerfile.backend -t rezics-backend:dev .

# --- build stage -----------------------------------------------------------
ARG BASE_IMAGE=rezics-base:dev
FROM ${BASE_IMAGE} AS build
WORKDIR /repo/packages/backend

RUN bun build src/cluster.ts --compile --minify-whitespace --minify-syntax \
  --target bun-linux-x64 --outfile backend

# --- runtime stage ---------------------------------------------------------
FROM debian:bookworm-slim AS runtime
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --system --uid 10001 --no-create-home rezics
WORKDIR /app

COPY --from=build /repo/packages/backend/backend /app/backend

USER rezics
ENV PORT=3000
ENV BACKEND_PORT=3000
ENV WORKERS=""
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${BACKEND_PORT}/health" || exit 1

ENTRYPOINT ["/app/backend"]
