#!/usr/bin/env bash
# Sync secrets from SOPS-encrypted env files to Nomad Variables.
# 从 SOPS 加密的 env 文件同步密钥到 Nomad Variables。
#
#   bin/nomad-sync-secrets              # sync all units
#   bin/nomad-sync-secrets server auth  # sync specific units
#
# Requires: SOPS_AGE_KEY or SOPS_AGE_KEY_FILE, NOMAD_ADDR, NOMAD_TOKEN
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SECRETS_DIR="${SCRIPT_DIR}/../config/secrets"

log() { printf '\033[1;34m==> %s\033[0m\n' "$*"; }
die() { printf '\033[1;31merror: %s\033[0m\n' "$*" >&2; exit 1; }

command -v sops  >/dev/null || die "sops CLI not found"
command -v nomad >/dev/null || die "nomad CLI not found"

: "${NOMAD_ADDR:?NOMAD_ADDR is required}"

ALL_UNITS=(common server auth notify reaction history ranking preview job-runner infra)

if [ $# -gt 0 ]; then
  UNITS=("$@")
else
  UNITS=("${ALL_UNITS[@]}")
fi

sync_unit() {
  local unit="$1"
  local enc_file="${SECRETS_DIR}/${unit}.enc.env"
  local nomad_path="rezics/${unit}"

  if [ ! -f "${enc_file}" ]; then
    log "  ${enc_file} not found, skipping ${unit}"
    return
  fi

  log "syncing ${enc_file} → nomad var ${nomad_path}"

  local decrypted
  decrypted=$(sops --decrypt "${enc_file}") || die "failed to decrypt ${enc_file}"

  local kv_args=()
  local count=0
  while IFS= read -r line; do
    # Skip empty lines and comments.
    # 跳过空行和注释。
    [[ -z "${line}" || "${line}" =~ ^[[:space:]]*# ]] && continue
    kv_args+=("${line}")
    count=$((count + 1))
  done <<< "${decrypted}"

  if [ "${count}" -eq 0 ]; then
    log "  (no secrets in ${enc_file}, skipping)"
    return
  fi

  nomad var put -force "${nomad_path}" "${kv_args[@]}"
  log "  synced ${count} secret(s) to ${nomad_path}"
}

for unit in "${UNITS[@]}"; do
  sync_unit "${unit}"
done

log "secret sync complete"
