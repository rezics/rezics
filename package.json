{
  "name": "rezics-book-library",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun run --no-env-file tool/dev-script/dev.ts",
    "prisma:generate": "cd tool && bun run db-script/prisma-regenerate.ts",
    "prisma:migrate": "cd tool && bun run db-script/prisma-migrate.ts",
    "prisma:reset": "cd tool && bun run db-script/prisma-reset-db.ts",
    "db:ensure:job-runner": "bun --filter=@rezics/job-runner run db:ensure",
    "deploy": "cd tool && bun run deploy",
    "check:runtime-env": "node tool/scripts/check-no-runtime-env.mjs",
    "service:up": "bun run tool/external-services/services.ts up",
    "service:down": "bun run tool/external-services/services.ts down",
    "service:logs": "bun run tool/external-services/services.ts logs",
    "service:ps": "bun run tool/external-services/services.ts ps",
    "service:health": "bun run tool/external-services/services.ts health",
    "service:config:plan": "bun run tool/external-services/services.ts config plan",
    "service:config:apply": "bun run tool/external-services/services.ts config apply",
    "service:source:verify": "bun run tool/external-services/services.ts source:verify",
    "service:source:repair": "bun run tool/external-services/services.ts source:repair",
    "service:sequin:up": "bun run service:up",
    "service:sequin:down": "bun run service:down",
    "service:sequin:logs": "bun run service:logs",
    "service:sequin:health": "bun run service:health",
    "service:sequin:config:plan": "bun run service:config:plan",
    "service:sequin:config:apply": "bun run service:config:apply",
    "service:sequin:source:prepare": "bun run service:source:verify",
    "seed": "bun run package/utils/bin/cli.ts",
    "factory": "bun run package/utils/bin/cli.ts factory",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:fix": "biome check --write .",
    "check": "biome check --write .",
    "check:convention": "bun run tool/scripts/check-convention.ts",
    "check:tokens": "bun run tool/scripts/check-tokens.ts",
    "knip": "knip",
    "check:i18n": "bun run tool/scripts/i18n/check-i18n.ts",
    "storybook:host": "storybook dev -p 6006 --no-open",
    "storybook:host:quiet": "storybook dev -p 6006 --no-open --quiet --loglevel error",
    "storybook:banner": "bun run tool/scripts/storybook-banner.ts",
    "storybook:all": "concurrently -k -n host,ui,editor,folio,admin,app,info -c blue,cyan,magenta,green,yellow,red,greenBright \"bun run storybook:host:quiet\" \"bun --filter=@rezics/ui run storybook -- --quiet --loglevel error\" \"bun --filter=@rezics/editor run storybook -- --quiet --loglevel error\" \"bun --filter=@rezics/folio run storybook -- --quiet --loglevel error\" \"bun --filter=@rezics/admin run storybook -- --quiet --loglevel error\" \"bun --filter=@rezics/app run storybook -- --quiet --loglevel error\" \"bun run storybook:banner\"",
    "storybook": "bun run storybook:all",
    "build-storybook:host": "storybook build -o storybook-static",
    "build-storybook:all": "concurrently -n host,ui,editor,folio,admin,app -c blue,cyan,magenta,green,yellow,red \"bun run build-storybook:host\" \"bun --filter=@rezics/ui run build-storybook\" \"bun --filter=@rezics/editor run build-storybook\" \"bun --filter=@rezics/folio run build-storybook\" \"bun --filter=@rezics/admin run build-storybook\" \"bun --filter=@rezics/app run build-storybook\"",
    "build-storybook": "bun run build-storybook:all",
    "postinstall": "lefthook install || true"
  },
  "workspaces": [
    "package/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@playwright/test": "^1.59.1",
    "@rezics/storybook-config": "workspace:*",
    "@rezics/ui": "workspace:*",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9",
    "knip": "^5.85.0",
    "lefthook": "^2.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.3.6",
    "ts-morph": "^28.0.0",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "@vitejs/plugin-react": "^5.1.4",
    "valibot": "^1.2.0",
    "better-result": "^2.7.0"
  },
  "patchedDependencies": {
    "storybook@10.3.6": "patches/storybook@10.3.6.patch"
  }
}
