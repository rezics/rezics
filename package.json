{
  "name": "rezics-book-library",
  "private": true,
  "scripts": {
    "dev": "cd tool && bun run dev-script/dev.ts",
    "docs:dev": "cd docs && bun run dev",
    "app:dev": "cd package/app && bun run dev",
    "server:dev": "cd package/server && bun run dev",
    "deploy": "cd tool && bun run deploy",
    "check:runtime-env": "node tool/scripts/check-no-runtime-env.mjs",
    "seed:cross": "bun run tool/seed/cross-seed.ts",
    "knip": "knip"
  },
  "workspaces": [
    "package/*"
  ],
  "devDependencies": {
    "babel-plugin-react-compiler": "^1.0.0",
    "vite": "^8.0.0-beta.16",
    "knip": "^5.85.0"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "@vitejs/plugin-react": "^5.1.4",
    "valibot": "^1.2.0"
  }
}
