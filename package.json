{
  "name": "rezics-book-library",
  "private": true,
  "scripts": {
    "dev": "cd tool && bun run dev-script/dev.ts",
    "prisma:regenerate": "cd tool && bun run dev-script/prisma-regenerate.ts",
    "deploy": "cd tool && bun run deploy",
    "check:runtime-env": "node tool/scripts/check-no-runtime-env.mjs",
    "seed": "cd tool && bun run seed/seed.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "check:convention": "bun run tool/scripts/check-convention.ts",
    "knip": "knip",
    "postinstall": "lefthook install || true"
  },
  "workspaces": [
    "package/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "knip": "^5.85.0",
    "lefthook": "^2.1.6",
    "vite": "^8.0.0-beta.16"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "@vitejs/plugin-react": "^5.1.4",
    "valibot": "^1.2.0",
    "better-result": "^2.7.0"
  }
}
