{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": ["."],
      "denyWrite": [
        "~/.ssh/**",
        "~/.gnupg/**",
        "~/.config/**",
        "~/.bashrc",
        "~/.zshrc"
      ],
      "denyRead": ["~/.ssh/**", "~/.gnupg/**"]
    }
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "WebSearch",
      "WebFetch(domain:elysiajs.com)",
      "Bash(openspec:*)",
      "Bash(openspec new:*)",
      "Bash(openspec status:*)",
      "Bash(openspec instructions:*)",
      "Bash(cd:*)",
      "Bash(bun test:*)",
      "Bash(bun install:*)",
      "Bash(grep:*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(rg:*)"
    ]
  },
  "deny": ["Bash(sudo:*)", "Bash(rm -rf /*)"]
}
