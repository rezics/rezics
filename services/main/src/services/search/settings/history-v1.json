{
	"searchableAttributes": [
		"search.historicalTitles",
		"search.editSummary",
		"search.publicContent"
	],
	"displayedAttributes": ["id", "revision", "unitId"],
	"filterableAttributes": [
		{
			"attributePatterns": [
				"unitId",
				"unitType",
				"filters.actorProfileId",
				"filters.minor",
				"filters.tags"
			],
			"features": {
				"facetSearch": false,
				"filter": { "equality": true, "comparison": false }
			}
		},
		{
			"attributePatterns": ["filters.createdAt"],
			"features": { "facetSearch": false, "filter": { "equality": true, "comparison": true } }
		}
	],
	"sortableAttributes": ["filters.createdAt"],
	"rankingRules": [
		"words",
		"typo",
		"proximity",
		"attribute",
		"sort",
		"exactness",
		"filters.createdAt:desc"
	],
	"faceting": { "maxValuesPerFacet": 100 },
	"pagination": { "maxTotalHits": 10000 }
}
