\set ON_ERROR_STOP on

DO $verification$
DECLARE
  index_name text;
BEGIN
  IF (SELECT extversion FROM pg_extension WHERE extname = 'pgroonga') <> '4.0.8' THEN
    RAISE EXCEPTION 'restored database does not use PGroonga 4.0.8';
  END IF;
  IF (SELECT extversion FROM pg_extension WHERE extname = 'approx_count') <> '1.0' THEN
    RAISE EXCEPTION 'restored database does not use approx_count 1.0';
  END IF;

  FOREACH index_name IN ARRAY ARRAY[
    '{{METADATA_INDEX}}',
    '{{CONTENT_INDEX}}',
    '{{ALIAS_INDEX}}'
  ] LOOP
    IF NOT EXISTS (
      SELECT 1
      FROM pg_index AS candidate
      JOIN pg_class AS index_relation ON index_relation.oid = candidate.indexrelid
      JOIN pg_namespace AS index_namespace ON index_namespace.oid = index_relation.relnamespace
      JOIN pg_am AS access_method ON access_method.oid = index_relation.relam
      WHERE index_namespace.nspname = 'public'
        AND index_relation.relname = index_name
        AND access_method.amname = 'pgroonga'
        AND candidate.indisvalid
        AND candidate.indisready
    ) THEN
      RAISE EXCEPTION 'restored PGroonga index is missing or invalid: %', index_name;
    END IF;
  END LOOP;
END
$verification$;

BEGIN;
SET LOCAL enable_seqscan = off;

