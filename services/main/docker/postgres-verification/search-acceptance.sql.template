DO $fixture$
DECLARE
  query_plan json;
BEGIN
  EXECUTE $query$
    EXPLAIN (FORMAT JSON)
    SELECT 1
    FROM public.unit_localization AS localization
    WHERE public.current_search_metadata_v1(
        localization.title,
        localization.summary,
        localization.description
      ) &@~ public.pgroonga_query_escape('rezicsmetadataacceptance')
  $query$ INTO query_plan;
  IF position('{{METADATA_INDEX}}' IN query_plan::text) = 0 THEN
    RAISE EXCEPTION 'metadata acceptance query did not plan the restored PGroonga index';
  END IF;

  PERFORM 1
  FROM public.unit_localization AS localization
  WHERE public.current_search_metadata_v1(
      localization.title,
      localization.summary,
      localization.description
    ) &@~ public.pgroonga_query_escape('rezicsmetadataacceptance')
    AND public.pgroonga_score(localization.tableoid, localization.ctid) > 0;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'restored metadata PGroonga index did not produce a scored match';
  END IF;

  EXECUTE $query$
    EXPLAIN (FORMAT JSON)
    SELECT 1
    FROM public.unit_localization AS localization
    WHERE public.current_search_text_v1(localization.content)
      &@~ public.pgroonga_query_escape('rezicsbodyacceptance')
  $query$ INTO query_plan;
  IF position('{{CONTENT_INDEX}}' IN query_plan::text) = 0 THEN
    RAISE EXCEPTION 'body acceptance query did not plan the restored PGroonga index';
  END IF;

  PERFORM 1
  FROM public.unit_localization AS localization
  WHERE public.current_search_text_v1(localization.content)
      &@~ public.pgroonga_query_escape('rezicsbodyacceptance')
    AND public.pgroonga_score(localization.tableoid, localization.ctid) > 0;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'restored content PGroonga index did not produce a scored match';
  END IF;

  EXECUTE $query$
    EXPLAIN (FORMAT JSON)
    SELECT 1
    FROM public.unit_alias AS alias
    JOIN public.unit_alias_vote_stat AS vote_stat ON vote_stat.alias_id = alias.id
    WHERE alias.withdrawn_at IS NULL
      AND vote_stat.score >= {{ALIAS_SCORE_THRESHOLD}}
      AND (alias.language IS NULL OR alias.language = 'en')
      AND alias.term &@~ public.pgroonga_query_escape('rezicsaliasacceptance')
  $query$ INTO query_plan;
  IF position('{{ALIAS_INDEX}}' IN query_plan::text) = 0 THEN
    RAISE EXCEPTION 'alias acceptance query did not plan the restored PGroonga index';
  END IF;

  PERFORM 1
  FROM public.unit_alias AS alias
  JOIN public.unit_alias_vote_stat AS vote_stat ON vote_stat.alias_id = alias.id
  WHERE alias.withdrawn_at IS NULL
    AND vote_stat.score >= {{ALIAS_SCORE_THRESHOLD}}
    AND (alias.language IS NULL OR alias.language = 'en')
    AND alias.term &@~ public.pgroonga_query_escape('rezicsaliasacceptance')
    AND public.pgroonga_score(alias.tableoid, alias.ctid) > 0;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'restored alias PGroonga index did not produce a scored match';
  END IF;
END
$fixture$;

ROLLBACK;
