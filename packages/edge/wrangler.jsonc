{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rezics-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-05",
  "assets": {
    "binding": "ASSETS",
    "directory": "../app/dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "PREVIEW_BASE_URL": "http://localhost:36003"
  }
}
