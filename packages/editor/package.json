{
	"name": "@rezics/editor",
	"version": "1.0.0",
	"description": "Loss-aware editor capabilities for CodeMirror, Portable Text, and REZICS Markdown.",
	"keywords": [
		"rezics",
		"editor",
		"markdown",
		"portable-text",
		"codemirror"
	],
	"homepage": "https://github.com/rezics/rezics/tree/main/packages/editor#readme",
	"bugs": "https://github.com/rezics/rezics/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rezics/rezics.git",
		"directory": "packages/editor"
	},
	"type": "module",
	"license": "AGPL-3.0-only",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/types/core/index.d.ts",
			"import": "./dist/core.js",
			"default": "./dist/core.js"
		},
		"./codemirror": {
			"types": "./dist/types/codemirror/index.d.ts",
			"import": "./dist/codemirror.js",
			"default": "./dist/codemirror.js"
		},
		"./portable-text": {
			"types": "./dist/types/portable-text/index.d.ts",
			"import": "./dist/portable-text.js",
			"default": "./dist/portable-text.js"
		},
		"./markdown": {
			"types": "./dist/types/markdown/index.d.ts",
			"import": "./dist/markdown.js",
			"default": "./dist/markdown.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "vite build && tsc --project tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepack": "yarn run build"
	},
	"peerDependencies": {
		"react": "19.2",
		"react-dom": "19.2"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"dependencies": {
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.4",
		"@codemirror/view": "^6.43.11",
		"@portabletext/editor": "^7.12.3",
		"@portabletext/markdown": "^2.0.0",
		"@portabletext/schema": "^3.0.0",
		"@portabletext/toolkit": "^6.0.0",
		"codemirror": "^6.0.2",
		"markdown-it": "^15.0.1",
		"mdast-util-gfm": "^3.1.0",
		"mdast-util-to-markdown": "^2.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@codemirror/commands": "^6.11.0",
		"@storybook/react-vite": "^11.0.0-alpha.0",
		"@types/markdown-it": "^14.2.0",
		"@types/mdast": "^4.0.4",
		"@types/node": "26.5.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"jsdom": "^30.0.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"storybook": "patch:storybook@npm%3A11.0.0-alpha.0#~/.yarn/patches/storybook-npm-11.0.0-alpha.0-3446b2455a.patch",
		"typescript": "7.0.2",
		"vite": "^8.2.2",
		"vitest": "4.1.10"
	}
}
