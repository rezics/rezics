    "./shared/fractional-index": {
      "types": "./src/shared/fractional-index.ts",
      "default": "./src/shared/fractional-index.ts"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "@tanstack/query-broadcast-client-experimental": "^5.96.2",
    "@tanstack/query-db-collection": "^1.0.36",
    "@tanstack/query-sync-storage-persister": "^5.96.2",
    "@tanstack/react-db": "^0.1.83",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-persist-client": "^5.96.2",
    "elysia": "^1.4.12",
    "memoirist": "^0.4.0",
    "zustand": "5.0.7"
  },
  "peerDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
