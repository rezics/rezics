{
  "name": "@rezics/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./api/content-structure": {
      "types": "./src/api/content-structure/content-structure.ts",
      "default": "./src/api/content-structure/content-structure.ts"
    },
    "./api/echokv": {
      "types": "./src/api/echokv/echokv.ts",
      "default": "./src/api/echokv/echokv.ts"
    },
    "./api/entity": {
      "types": "./src/api/entity/index.ts",
      "default": "./src/api/entity/index.ts"
    },
    "./api/hooks": {
      "types": "./src/api/hooks/index.ts",
      "default": "./src/api/hooks/index.ts"
    },
    "./api/notification": {
      "types": "./src/api/notification/index.ts",
      "default": "./src/api/notification/index.ts"
    },
    "./api/shelf": {
      "types": "./src/api/shelf/index.ts",
      "default": "./src/api/shelf/index.ts"
    },
    "./api/*": {
      "types": "./src/api/*.ts",
      "default": "./src/api/*.ts"
    },
    "./language-core": {
      "types": "./src/language-core.ts",
      "default": "./src/language-core.ts"
    },
    "./meili": {
      "types": "./src/meili/index.ts",
      "default": "./src/meili/index.ts"
    },
    "./reaction": {
      "types": "./src/reaction/index.ts",
      "default": "./src/reaction/index.ts"
