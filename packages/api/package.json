{
	"name": "@rezics/api",
	"version": "1.11.0",
	"description": "Type-safe REZICS API client generated from the public OpenAPI contract.",
	"keywords": [
		"rezics",
		"api",
		"openapi",
		"typescript"
	],
	"homepage": "https://github.com/rezics/rezics/tree/main/packages/api#readme",
	"bugs": "https://github.com/rezics/rezics/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rezics/rezics.git",
		"directory": "packages/api"
	},
	"type": "module",
	"license": "AGPL-3.0-only",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"generate": "KUBB_DISABLE_TELEMETRY=1 kubb generate --config ./kubb.config.ts",
		"build": "vite build && tsc --project tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepack": "yarn run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@kubb/adapter-oas": "5.1.0",
		"@kubb/plugin-fetch": "5.3.0",
		"@kubb/plugin-ts": "5.0.1",
		"kubb": "5.1.0",
		"typescript": "7.0.2",
		"vite": "^8.2.2",
		"vitest": "4.1.10"
	}
}
