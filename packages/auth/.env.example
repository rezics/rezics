NODE_ENV=development

# ── Database ──────────────────────────────────────────────
AUTH_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_auth?schema=public"

# ── Better Auth Core ──────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3001
AUTH_PUBLIC_BASE_URL=http://localhost:3000/auth
AUTH_PUBLIC_ISSUER_URL=http://localhost:3000
BETTER_AUTH_SECRET="change-me-to-a-random-base64-secret"
# BETTER_AUTH_SECRETS=             # supplemental secrets for rotation

# ── Internal Security ────────────────────────────────────
AUTH_INTERNAL_TOKEN_GATEWAY_SECRET="change-me-to-a-random-base64-secret"
AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# AUTH_OPENAPI_ROUTER_PREFIX=/api/auth

# ── JWT & JWKS (bootstrap-only) ──────────────────────────
# These seed the auth JWT service record on first run.
# AUTH_JWT_ISSUER=http://localhost:3000
# AUTH_JWT_AUDIENCE=
# AUTH_JWT_TTL_SECONDS=3600
# AUTH_JWKS_ROTATION_INTERVAL_SECONDS=
# AUTH_JWKS_GRACE_PERIOD_SECONDS=

# ── SMTP ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=true
SMTP_USER=user@example.com
# SMTP_USER_NAME="App Support"
SMTP_PASSWORD=change-me-smtp-password

# ── Email Senders (optional) ─────────────────────────────
# AUTH_PASSWORD_RESET_FROM_EMAIL=
# AUTH_VERIFICATION_FROM_EMAIL=

# ── Turnstile (Cloudflare CAPTCHA) ───────────────────────
# Cloudflare test secret — always passes in dev
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ── OAuth Providers (optional) ───────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TELEGRAM_CLIENT_ID=
# TELEGRAM_CLIENT_SECRET=

# ── Server ────────────────────────────────────────────────
# PORT=3001
