NODE_ENV=development

# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_server?schema=public"

# ── Auth Service ──────────────────────────────────────────
# Internal base URL of the auth service. Browser-facing auth uses main /auth/*.
AUTH_INTERNAL_BASE_URL=http://localhost:3001
AUTH_PUBLIC_BASE_URL=http://localhost:3000/auth
AUTH_PUBLIC_ISSUER_URL=http://localhost:3000
AUTH_INTERNAL_TOKEN_GATEWAY_SECRET="change-me-to-a-random-base64-secret"
# AUTH_JWT_AUDIENCE=rezics
# AUTH_JWT_CLOCK_TOLERANCE_SECONDS=5

# ── Session Token ────────────────────────────────────────
# MAIN_SESSION_JWT_TTL_SECONDS=900
# MAIN_SESSION_JWKS_ROTATION_SECONDS=2592000

# ── Search ────────────────────────────────────────────────
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=masterKey

# ── SMTP ─────────────────────────────────────────────────
# Main reads these values and passes them explicitly to @rezics/email for
# product email verification flows such as user.email.
SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
SMTP_USER=user@example.com
SMTP_PASSWORD=change-me-smtp-password
# MAIN_EMAIL_FROM_EMAIL=noreply@rezics.com
# MAIN_EMAIL_FROM_NAME="Rezics"

# ── Turnstile ────────────────────────────────────────────
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ── S3 Media Storage (optional) ──────────────────────────
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=auto
# MEDIA_PUBLIC_BASE_URL=
# MEDIA_MAX_UPLOAD_SIZE=10485760
# MEDIA_PRESIGN_EXPIRY=600

# ── Internal Services ────────────────────────────────────
NOTIFY_BASE_URL=http://localhost:3002
NOTIFY_INTERNAL_SECRET=change-me-notify-internal-secret
REACTION_BASE_URL=http://localhost:3003
REACTION_INTERNAL_SECRET=change-me-reaction-internal-secret
HISTORY_BASE_URL=http://localhost:3000/__services/history

# Job runner producer endpoint. The server only enqueues commands; it does not
# receive JOB_DATABASE_URL or run pg-boss workers.
JOB_RUNNER_BASE_URL=http://localhost:3005
JOB_RUNNER_INTERNAL_SECRET=change-me-job-runner-internal-secret

# ── Internal Status ──────────────────────────────────────
# Non-secret URLs and display metadata for the root/admin status page.
STATUS_APP_URL=http://localhost:35001
STATUS_SERVER_URL=http://localhost:3000
STATUS_AUTH_HEALTH_URL=http://localhost:3001/health
STATUS_JOB_RUNNER_URL=http://localhost:3005
STATUS_MEILI_URL=http://localhost:7700
STATUS_SEQUIN_UI_URL=http://localhost:7376
STATUS_SEQUIN_HEALTH_URL=http://localhost:7376/health
STATUS_SEQUIN_WEBHOOK_TARGET_NAME="job-runner /webhooks/sequin"
STATUS_CDC_PUBLICATION_NAME=rezics_sequin_pub_development
STATUS_CDC_REPLICATION_SLOT_NAME=rezics_sequin_slot_development
STATUS_REACTION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_reaction?schema=public"
STATUS_REACTION_CDC_PUBLICATION_NAME=rezics_reaction_sequin_pub_development
STATUS_REACTION_CDC_REPLICATION_SLOT_NAME=rezics_reaction_sequin_slot_development
STATUS_CDC_LAG_WARNING_BYTES=268435456

# ── Server ────────────────────────────────────────────────
# PORT=3000
