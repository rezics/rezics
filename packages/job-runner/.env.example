NODE_ENV=development

# ── Queue Database ───────────────────────────────────────
# Dedicated pg-boss database. Do not reuse the main server database.
JOB_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_jobs"

# ── Source Databases ─────────────────────────────────────
# Main server database used for current-state reads while executing jobs.
SERVER_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_server?schema=public"

# History database used by history outbox ingestion jobs.
HISTORY_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezics_history?schema=public"
HISTORY_INTERNAL_SECRET=dev-history-secret

# Ranking service used by ranking command workers.
RANKING_BASE_URL=http://localhost:3006
# RANKING_INTERNAL_SECRET=your-ranking-internal-secret

# ── Search ────────────────────────────────────────────────
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=masterKey

# ── Internal Auth ─────────────────────────────────────────
# Must match @rezics/server JOB_RUNNER_INTERNAL_SECRET.
JOB_RUNNER_INTERNAL_SECRET=change-me-job-runner-internal-secret

# Shared secret expected on Sequin webhook delivery.
# Must match tool/.env SEQUIN_WEBHOOK_SECRET.
SEQUIN_WEBHOOK_SECRET=change-me-sequin-webhook-secret

# Exposed by `bun run service up`.
SEQUIN_HEALTH_URL=http://127.0.0.1:7376/health

# ── Service ───────────────────────────────────────────────
# all = HTTP API + workers; http = API only; worker = workers only.
JOB_RUNNER_ROLE=all
PORT=3005
